meatball-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/1c2995208f694197a4d2cdae0535988a/JetFBMeatballs.jpg', 'video_id': 39607, 'video_url': 'https://vid.tasty.co/output/69379/hls24_1513798345.m3u8'}, {'approved_at': 1580777511, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1388', 'country': 'US', 'created_at': 1580453851, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 1388, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '11 Deliciously Epic Meatball Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '11-deliciously-epic-meatball-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/253648.jpg', 'video_id': 99735, 'video_url': 'https://vid.tasty.co/output/159047/hls24_1580453958.m3u8'}], 'cook_time_minutes': 25, 'country': 'ZZ', 'created_at': 1502485659, 'credits': [{'is_verified': False, 'name': 'Matthew Johnson', 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"These meatballs are smokin' hot and bursting with flavor! With a tangy barbecue sauce and sweet caramelized onions, they're the perfect appetizer for your next backyard bash. Serve them up on a platter and watch them disappear faster than a plate of hot wings.\", 'draft_status': 'published', 'facebook_posts': [], 'id': 2269, 'inspired_by_url': 'https://www.youtube.com/watch?v=0Nxdj8C-VZI', 'instructions': [{'appliance': 'oven', 'display_text': 'Preheat oven to 425°F (220°C).', 'end_time': 0, 'id': 19057, 'position': 1, 'start_time': 0, 'temperature': 425}, {'appliance': None, 'display_text': 'In a medium-size bowl mix together the beef, pork, bread crumbs, onion, parsley, garlic, eggs, salt, and pepper until just combined.', 'end_time': 13500, 'id': 19058, 'position': 2, 'start_time': 3500, 'temperature': None}, {'appliance': None, 'display_text': 'Take a walnut size of the meat mixture and roll into a ball. Repeat with remaining meat and transfer to an oiled rack on a sheet tray.', 'end_time': 19000, 'id': 19059, 'position': 3, 'start_time': 14500, 'temperature': None}, {'appliance': None, 'display_text': 'Bake meatballs for 15 minutes, until golden brown. Set aside.', 'end_time': 21300, 'id': 19060, 'position': 4, 'start_time': 20000, 'temperature': None}, {'appliance': None, 'display_text': 'Add oil to a pan on medium-high heat, and cook onions and garlic until they are deeply caramelized.', 'end_time': 29370, 'id': 19061, 'position': 5, 'start_time': 22300, 'temperature': None}, {'appliance': None, 'display_text': 'Add in the cider vinegar, ketchup, tomato paste, mustard, Worcestershire, honey, brown sugar, stir, and bring to a simmer. About 5 minutes.', 'end_time': 42500, 'hacks': [{'end_index': 120, 'id': 17, 'match': 'simmer', 'start_index': 115}], 'id': 19062, 'position': 6, 'start_time': 29950, 'temperature': None}, {'appliance': None, 'display_text': 'Add salt and pepper to taste (optional).', 'end_time': 0, 'id': 19110, 'position': 7, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Add the cooked meatballs and coat them with the sauce.', 'end_time': 46000, 'id': 19063, 'position': 8, 'start_time': 43500, 'temperature': None}, {'appliance': None, 'display_text': 'Sprinkle with the fried onions, poke with toothpicks, and serve!', 'end_time': 51000, 'id': 19064, 'position': 9, 'start_time': 47000, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 53290, 'id': 19108, 'position': 10, 'start_time': 52000, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': ', balls, barbecue, bbq, beef, best, best ever, buzzfeed, cheese, cheesy, classic, cocktail, cook, easy, food, galzed yum, garlic, ginger, glaxe, honey, how to, marinara, meatball, meatballs, mini, onion