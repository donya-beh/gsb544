': 'Tasty'}], 'slug': '7-cheesy-recipes-that-will-take-you-to-cheese-heaven', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/221528.jpg', 'video_id': 85815, 'video_url': 'https://vid.tasty.co/output/136441/hls24_1560926500.m3u8'}, {'approved_at': 1576638857, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1339', 'country': 'US', 'created_at': 1576479268, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 1339, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': \"5 Meatball Recipes You Can't Resist\", 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '5-meatball-recipes-you-can-t-resist', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/247851.jpg', 'video_id': 97304, 'video_url': 'https://vid.tasty.co/output/154983/hls24_1576234793.m3u8'}, {'approved_at': 1617627474, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2242', 'country': 'US', 'created_at': 1616586858, 'description': 'Give yourself an easy cooking day with these slow cooker recipes that require little work on your part! Start your day dessert-style with a <a href=\"https://tasty.co/recipe/slow-cooker-blueberry-cobbler\">Blueberry Cobbler.</a> For a wholesome lunch, this <a href=\"https://tasty.co/recipe/slow-cooker-turkey-chili-with-cornbread-dumplings\">Turkey chili</a> with cornbread dumplings on the side is the way to go! For a little afternoon pick-me-up, whip up a cozy <a href=\"https://tasty.co/recipe/mocha-latte-slow-cooker-eggnog\">mocha latte eggnog,</a> and round your night off with some <a href=\"https://tasty.co/recipe/easy-slow-cooker-mozzarella-stuffed-meatballs-and-sauce\">Mozzarella Stuffed Meatballs.</a> Who said you have to do all the heavy lifting? Let the slow cooker take over! ', 'draft_status': 'published', 'facebook_posts': [], 'id': 2242, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Slow Cooker Recipes That Basically Cook Themselves!', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'slow-cooker-recipes-that-basically-cook-themselves', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/313962.jpg', 'video_id': 127722, 'video_url': 'https://vid.tasty.co/output/197446/hls24_1616586913.m3u8'}, {'approved_at': 1621000224, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2385', 'country': 'US', 'created_at': 1619787532, 'description': 'When we think of a cheese that can do pretty much anything, we think of mozzarella — it\\'s mild, melty, and, well, mouthwatering. Our <a href=\"https://tasty.co/recipe/mozzarella-stick-onion-rings\">mozzarella stick onion rings</a> are guaranteed to be a hit for any occasion, and we all know that there isn\\'t a more iconic combination than some mozzarella in an ooey, gooey, comforting <a href=\"https://tasty.co/recipe/caprese-mac-n-cheese\">mac \\'n\\' cheese</a>! You can also mix up your <a href=\"https://tasty.co/recipe/easy-slow-cooker-mozzarella-stuffed-meatballs-and-sauce\">meatballs</a> by stuffing them with some mozz. Let\\'s eat!', 'draft_status': 'published', 'facebook_posts': [], 'id': 2385, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'More And More Mozzarella', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'more-and-more-mozzarella', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/320239.jpg', 'video_id': 130701, 'video_url': 'https://vid.tasty.co/output/201819/hls24_1619788779.m3u8'}, {'approved_at': 1622553018, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2411', 'country': 'US', 'created_at': 1621404764, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 2411, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Dinner Recipes For Every Night In June', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'dinner-recipes-for-every-night-in-june', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/324707.jpg', 'video_id': 132409, 'video_url': 'https://vid.tasty.co/output/204546/hls24_1622408779.m3u8'}, {'approved_at': 1635784826, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2896', 'country': 'US', 'created_at': 1634890466, 'description': 'Whether you\\'re a busy home cook, a lazy one, or a chef-in-training, your slow cooker is a total gift. Use it to make easy soups and stews like <a href=\"https://tasty.co/recipe/slow-cooker-butternut-squash-soup\">butternut squash soup</a> and <a href=\"https://tasty.co/recipe/slow-cooker-turkey-chili-with-cornbread-dumplings\">turkey chili</a>. Or task it with all your basic recipes from mashed potatoes to pot roast. Or you can get sophisticated and whip up a <a href=\"https://tasty.co/recipe/slow-cooker-thai-green-curry\">Thai-inspired green curry</a>. The options are endless!', 'draft_status': 'published', 'facebook_posts': [], 'id': 2896, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '30 Days 30 Slow Cooker Recipes ', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '30-days-30-slow-cooker-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/350085.jpg', 'video_id': 144481, 'video_url': 'https://vid.tasty.co/output/221090/hls24_1635529947.m3u8'}, {'approved_at': 1636384210, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2901', 'country': 'US', 'created_at': 1635417456, 'description': 'If you worship cheese like we do, then we have a treat for you. Our <a href=\"https://tasty.co/recipe/cheese-stuffed-mushroom-burger\">cheese-stuffed mushroom burger</a> can compete with Shake Shack\\'s best, and our <a href=\"https://tasty.co/recipe/cheese-stuffed-burger-dogs\">cheesy burger dogs</a> are not for the faint of heart. Oh, and did someone say <a href=\"https://tasty.co/recipe/broccoli-cheddar-chicken-rollups\">broccoli cheddar chicken roll-ups</a>? Bring us a plate, ASAP! ', 'draft_status': 'published', 'facebook_posts': [], 'id': 2901, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Cheese-Stuffed Foods That Will Change Your Life', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'cheese-stuffed-foods-that-will-change-your-life', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/349512.jpg', 'video_id': 143367, 'video_url': 'https://vid.tasty.co/output/220423/hls24_1635417529.m3u8'}, {'approved_at': 1652970321, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:3166', 'country': 'US', 'created_at': 1652425041, 'description': 'Meatballs are easy and fun to make from scratch and they\\'re perfect for all of your favorite recipes! You can pair them with spaghetti, sandwiches, soups, and game-day snacks! We are here to share some amazing meatball recipes with you! Try out our <a href=\"https://tasty.co/recipe/cheesy-meatball-bake\">Cheesy Meatball Bake</a> and these cheesy and crispy. <a href=\"https://tasty.co/recipe/meatball-mozzarella-sticks\">Meatball Mozzarella Sticks</a> that will make you the King or Queen of meatballs!', 'draft_status': 'published', 'facebook_posts': [], 'id': 3166, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Meatballs For Everyone!', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'meatballs-for-everyone', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/377777.jpg', 'video_id': 157501, 'video_url': 'https://vid.tasty.co/output/239268/hls24_1652425377.m3u8'}], 'cook_time_minutes': 150, 'country': 'US', 'created_at': 1516729083, 'credits': [{'is_verified': False, 'name': None, 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': 'Tender and flavorful meatballs stuffed with gooey mozzarella cheese, simmered in a homemade tomato sauce. Perfect for a cozy family dinner or meal prepping.', 'draft_status': 'published', 'facebook_posts': [], 'id': 3385, 'inspired_by_url': None, 'instructions': [{'appliance': None, 'display_text': 'Combine all sauce ingredients in slow cooker and stir. Set to high and cover while making meatballs, or for 30 minutes. (Or use pre-made/canned sauce.)', 'end_time': 0, 'id': 28680, 'position': 1, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Combine all meatball ingredients except the mozzarella in a large bowl. Using your hands, mix until fully combined.', 'end_time': 26500, 'id': 28681, 'position': 2, 'start_time': 11666, 'temperature': None}, {'appliance': None, 'display_text': 'Take a golf ball sized piece of the ground beef mixture and place a piece of mozzarella in the middle. Press meat around the piece of cheese, fully enclosing it. Repeat until all meat is used.', 'end_time': 34750, 'id': 28682, 'position': 3, 'start_time': 26833, 'temperature': None}, {'appliance': None, 'display_text': 'Place meatballs in slow cooker and submerge in sauce.', 'end_time': 43166, 'id': 28683, 'position': 4, 'start_time': 38083, 'temperature': None}, {'appliance': None, 'display_text': 'Cover and cook on high for 2-2½  hours, or until meat is fully cooked.', 'end_time': 0, 'id': 28684, 'position': 5, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Serve by itself or over pasta.', 'end_time': 49583, 'id': 28685, 'position': 6, 'start_time': 46000, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 53083, 'id': 28686, 'position': 7, 'start_time': 49584, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': None, 'language': 'eng', 'name': 'Easy Slow Cooker Mozzarella-Stuffed Meatballs And Sauce', 'num_servings': 14, 'nutrition': {}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/2925b676c48e48b4bea34ef48ea734d5/BFV3829_MozzarellaStuffedMeatballs-FB1080SQ.mp4', 'prep_time_minutes': 45, 'price': {'consumption_portion': 150, 'consumption_total': 2000, 'portion': 250, 'total': 3450, 'updated_at': '2025-10-26T06:06:48+01:00'}, 'promotion': 'full', 'renditions': [{'aspect': 'square', 'bit_rate': 7452, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 57519, 'file_size': 53574763, 'height': 720, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_720x720', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/35556/mp4_1280X720/1498683294_00001.png', 'url': 'https://vid.tasty.co/output/35556/mp4_1280X720/1498683294', 'width': 720}, {'aspect': 'square', 'bit_rate': None, 'container': 'mp4', 'content_type': 'application/vnd.apple.mpegurl', 'duration': 57533, 'file_size': None, 'height': 1080, 'maximum_bit_rate': 8320, 'minimum_bit_rate': 278, 'name': 'low', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/35556/1445289064805-h2exzu/1498683294_00001.png', 'url': 'https://vid.tasty.co/output/35556/low_1498683294.m3u8', 'width': 1080}, {'aspect': 'square', 'bit_rate': 7388, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 57519, 'file_size': 53114268, 'height': 640, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_640x640', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/35556/mp4_640x640/1498683294_00001.png', 'url': 'https://vid.tasty.co/output/35556/mp4_640x640/1498683294', 'width': 640}, {'aspect': 'square', 'bit_rate': 7442, 'c