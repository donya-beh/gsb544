', 'id': 8104112, 'name': 'mccormick_world_vegetarian', 'parent_tag_name': None, 'root_tag_type': 'feature_page', 'type': 'feature_page'}, {'display_name': 'Walmart Meal Planning', 'id': 8323092, 'name': 'walmart_meal_planning', 'parent_tag_name': None, 'root_tag_type': 'business_tags', 'type': 'business_tags'}, {'display_name': 'Meal', 'id': 9295813, 'name': 'meal', 'parent_tag_name': None, 'root_tag_type': 'meal', 'type': 'meal'}, {'display_name': 'Eggs', 'id': 10623588, 'name': 'eggs', 'parent_tag_name': 'ingredients_to_avoid', 'root_tag_type': 'ingredients_to_avoid', 'type': 'ingredients_to_avoid'}, {'display_name': 'Gluten', 'id': 10623589, 'name': 'gluten', 'parent_tag_name': 'ingredients_to_avoid', 'root_tag_type': 'ingredients_to_avoid', 'type': 'ingredients_to_avoid'}, {'display_name': 'Dairy', 'id': 10623608, 'name': 'dairy', 'parent_tag_name': 'ingredients_to_avoid', 'root_tag_type': 'ingredients_to_avoid', 'type': 'ingredients_to_avoid'}, {'display_name': 'Budget', 'id': 10742773, 'name': 'budget', 'parent_tag_name': 'cooking_style', 'root_tag_type': 'cooking_style', 'type': 'cooking_style'}], 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/1ab849f8df6643a994dd9b864039fbfc/BFV32770_6HighProteinVegetarianDinners_FB.jpg', 'tips_and_ratings_enabled': True, 'tips_summary': {'by_line': 'Powered By Botatouille', 'content': '• Add more herbs and spices for a flavor explosion! 🌿✨\\n• Increase the amount of breadcrumbs to keep those meatballs from crumbling like my hopes on a Monday! 🍞😅\\n• Experiment with different cheeses or skip it for a dairy-free delight! 🧀🚫\\n• Toss in some veggies like carrots and mushrooms for a colorful crunch! 🥕🍄🌈\\n• Chill the mixture before rolling for meatballs that hold their shape like a well-prepared dancer! ❄️💃', 'header': 'Highlights'}, 'topics': [{'name': 'Best Vegetarian', 'slug': 'best-vegetarian'}, {'name': 'Healthy Eating', 'slug': 'healthy'}, {'name': 'Low Carb Meals', 'slug': 'low-carb-meals'}, {'name': 'Dinner', 'slug': 'dinner'}, {'name': 'American', 'slug': 'american'}, {'name': 'Italian', 'slug': 'italian'}], 'total_time_minutes': 35, 'total_time_tier': {'display_tier': 'Under 45 minutes', 'tier': 'under_45_minutes'}, 'updated_at': 1684101600, 'user_ratings': {'count_negative': 36, 'count_positive': 342, 'score': 0.9047619047619048}, 'video_ad_content': 'none', 'video_id': 36847, 'video_url': 'https://vid.tasty.co/output/65581/hls24_1512413358.m3u8', 'yields': 'Serves: 12'}, {'approved_at': 1621258546, 'aspect_ratio': '1:1', 'beauty_url': None, 'brand': None, 'brand_id': None, 'buzz_id': None, 'canonical_id': 'recipe:7340', 'compilations': [], 'cook_time_minutes': 30, 'country': 'US', 'created_at': 1620865348, 'credits': [{'is_verified': False, 'name': None, 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': 'Chicken dinner takes a new shape with these savory meatballs! They’re baked, not fried, for a hands-off, mess-free meal. Serve over your favorite pasta and sauce, or alongside your favorite vegetables. Hint: Make a double batch and freeze half for another night!', 'draft_status': 'published', 'facebook_posts': [], 'id': 7340, 'inspired_by_url': None, 'instructions': [{'appliance': 'oven', 'display_text': 'Preheat the oven to 400°F (200°C). Line a rimmed baking sheet with foil.', 'end_time': 0, 'id': 64505, 'position': 1, 'start_time': 0, 'temperature': 400}, {'appliance': None, 'display_text': 'Heat the olive oil in a large pan over medium-high heat. Once the oil begins to shimmer, add the onion and cook, stirring often, until softened and golden brown, about 7 minutes.', 'end_time': 12266, 'id': 64506, 'position': 2, 'start_time': 5666, 'temperature': None}, {'appliance': None, 'display_text': 'Add the garlic and cook, stirring constantly, until aromatic, about 1 minute. Remove the pan from the heat and let the onion mixture cool to room temperature.', 'end_time': 17833, 'id': 64507, 'position': 3, 'start_time': 13000, 'temperature': None}, {'appliance': None, 'display_text': 'In a large bowl, combine the ground chicken, egg, panko, Parmesan, parsley, salt, pepper, and the onion mixture and use your hands to mix until just combined.', 'end_time': 37000, 'id': 64508, 'position': 4, 'start_time': 19000, 'temperature': None}, {'appliance': None, 'display_text': 'Roll the chicken mixture into 1½-inch balls and place on the prepared baking sheet, spacing 2 inches apart.', 'end_time': 43666, 'id': 64509, 'position': 5, 'start_time': 39000, 'temperature': None}, {'appliance': None, 'display_text': 'Bake the meatballs until browned and cooked through, 20 to 25 minutes.', 'end_time': 45666, 'hacks': [{'end_index': 31, 'id': 13, 'match': 'browned', 'start_index': 25}, {'end_index': 50, 'id': 21, 'match': 'cooked through', 'start_index': 37}], 'id': 64510, 'position': 6, 'start_time': 44000, 'temperature': None}, {'appliance': None, 'display_text': 'Serve with pasta and sauce of your choice.', 'end_time': 51166, 'id': 64511, 'position': 7, 'start_time': 48000, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 55500, 'id': 64512, 'position': 8, 'start_time': 53833, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': '', 'language': 'eng', 'name': 'Chicken Meatballs', 'num_servings': 14, 'nutrition': {'calories': 103, 'carbohydrates': 5, 'fat': 5, 'fiber': 0, 'protein': 9, 'sugar': 1, 'updated_at': '2024-05-01T08:03:09+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/9fed09fc897745f4a5293db557db5942/BFV78783_50TastyCoVideosQF_ChickenMeatballs_EG_04292021_v04_1x1_IG.mp4', 'prep_time_minutes': 10, 'price': {'consumption_portion': 50, 'consumption_total': 500, 'portion': 150, 'total': 1750, 'updated_at': '2025-10-26T06:23:47+01:00'}, 'promotion': 'full', 'renditions': [{'aspect': 'square', 'bit_rate': 1961, 'con