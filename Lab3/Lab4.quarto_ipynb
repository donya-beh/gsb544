ps://img.buzzfeed.com/thumbnailer-prod-us-east-1/1c2995208f694197a4d2cdae0535988a/JetFBMeatballs.jpg', 'video_id': 39607, 'video_url': 'https://vid.tasty.co/output/69379/hls24_1513798345.m3u8'}, {'approved_at': 1580777511, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1388', 'country': 'US', 'created_at': 1580453851, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 1388, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '11 Deliciously Epic Meatball Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '11-deliciously-epic-meatball-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/253648.jpg', 'video_id': 99735, 'video_url': 'https://vid.tasty.co/output/159047/hls24_1580453958.m3u8'}, {'approved_at': 1628614668, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2737', 'country': 'US', 'created_at': 1628111091, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 2737, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '4 Game Day Foods Around The World', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '4-game-day-foods-around-the-world', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/335376.jpg', 'video_id': 138332, 'video_url': 'https://vid.tasty.co/output/211833/hls24_1628095001.m3u8'}, {'approved_at': 1635864464, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2908', 'country': 'US', 'created_at': 1635420000, 'description': 'Everyone loves meatballs, and these easy recipes will make you a meatball expert in no time. Our <a href=\"https://tasty.co/recipe/teriyaki-meatballs\">teriyaki meatballs</a> are the perfect blend of sweet and savory, and we absolutely love these <a href=\"https://tasty.co/recipe/bbq-bacon-onion-meatball-bomb\">BBQ bacon and onion-wrapped meatballs</a>. Looking for something to impress a crowd? Give our <a href=\"https://tasty.co/recipe/giant-spaghetti-stuffed-meatball\">giant spaghetti-stuffed meatball</a> a go. It’s always a crowd favorite.', 'draft_status': 'published', 'facebook_posts': [], 'id': 2908, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Homemade Fancy Meatball Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'homemade-fancy-meatball-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/349526.jpg', 'video_id': 143754, 'video_url': 'https://vid.tasty.co/output/220430/hls24_1635419991.m3u8'}], 'cook_time_minutes': 25, 'country': 'ZZ', 'created_at': 1502485660, 'credits': [{'is_verified': False, 'name': 'Matthew Johnson', 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"Get ready to do the cha-cha with these Swedish meatballs! With a creamy gravy sauce and delicate spices, they're a party in your mouth that will have you dancing for joy. Serve them up on toothpicks for a fun and easy appetizer that everyone will love.\", 'draft_status': 'published', 'facebook_posts': [], 'id': 2272, 'inspired_by_url': 'http://www.foodnetwork.com/recipes/alton-brown/swedish-meatballs-recipe-1916539', 'instructions': [{'appliance': 'oven', 'display_text': 'Preheat oven to 425°F (220°C).', 'end_time': 0, 'id': 19093, 'position': 1, 'start_time': 0, 'temperature': 425}, {'appliance': None, 'display_text': 'In a medium-size bowl mix together the beef, pork, bread crumbs, onion, parsley, garlic, eggs, salt, and pepper until just combined.', 'end_time': 13500, 'id': 19094, 'position': 2, 'start_time': 3500, 'temperature': None}, {'appliance': None, 'display_text': 'Take a walnut size of the meat mixture and roll into a ball. Repeat with remaining meat and transfer to an oiled rack on a sheet tray.', 'end_time': 19000, 'id': 19095, 'position': 3, 'start_time': 14500, 'temperature': None}, {'appliance': None, 'display_text': 'Bake meatballs for 15 minutes, until golden brown. Set aside.', 'end_time': 21000, 'id': 19096, 'position': 4, 'start_time': 20000, 'temperature': None}, {'appliance': None, 'display_text': 'Melt butter in a pan on medium heat and allow it to brown slightly. Stir in the flour completely and cook for about 1 minute creating a pale roux.', 'end_time': 58000, 'id': 19097, 'position': 5, 'start_time': 54000, 'temperature': None}, {'appliance': None, 'display_text': 'Add the beef broth, stir, and cook until it thickens.', 'end_time': 62200, 'id': 19098, 'position': 6, 'start_time': 59000, 'temperature': None}, {'appliance': None, 'display_text': 'Add in the ground allspice, nutmeg, salt, pepper, and the heavy cream, stir, and bring to a simmer for 5 minutes.', 'end_time': 72200, 'hacks': [{'end_index': 97, 'id': 17, 'match': 'simmer', 'start_index': 92}], 'id': 19099, 'position': 7, 'start_time': 63200, 'temperature': None}, {'appliance': None, 'display_text': 'Add the meatballs and coat them with the gravy.', 'end_time': 75500, 'id': 19100, 'position': 8, 'start_time': 73200, 'temperature': None}, {'appliance': None, 'display_text': 'Sprinkle with the parsley, poke with toothpicks, and serve!', 'end_time': 80180, 'id': 19101, 'position': 9, 'start_time': 76500, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 82500, 'id': 19112, 'position': 10, 'start_time': 81000, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': ', balls, barbecue, bbq, beef, best, best ever, buzzfeed, cheese, cheesy, classic, cocktail, cook, easy, food, galzed yum, garlic, ginger, glaxe, honey, how to, marinara, meatball, meatballs, mini, onion, parm, parmsean, party meatballs, perfect, pork, recipe, sauce, saucy, sesame, soy, swedish, tasty, teriyaki, tomato, toothpick, ultimate, yummy', 'language': 'und', 'name': 'Swedish Meatballs', 'num_servings': 40, 'nutrition': {'calories': 109, 'carbohydrates': 2, 'fat': 7, 'fiber': 0, 'protein': 6, 'sugar': 0, 'updated_at': '2024-05-01T08:09:38+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/8f9e929d3d334bdeb60d65085358367e/FB_05_for_Final.mp4', 'prep_time_minutes': 30, 'price': {'consumption_portion': 50, 'consumption_total': 1300, 'portion': 50, 'total': 2400, 'updated_at': '2025-10-26T06:09:06+01:00'}, 'promotion': 'full', 'renditions': [{'aspect': 'square', 'bit_rate': 7314, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 149402, 'file_size': 136581580, 'height': 720, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_720x720', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/47184/mp4_1280X720/1502490038_00001.png', 'url': 'https://vid.tasty.co/output/47184/mp4_1280X720/1502490038', 'width': 720}, {'aspect': 'square', 'bit_rate': None, 'container': 'mp4', 'content_type': 'application/vnd.apple.mpegurl', 'duration': 149358, 'file_size': None, 'height': 1080, 'maximum_bit_rate': 7903, 'minimum_bit_rate': 274, 'name': 'low', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/47184/1445289064805-h2exzu/1502490038_00001.png', 'url': 'https://vid.tasty.co/output/47184/low_1502490038.m3u8', 'width': 1080}, {'aspect': 'square', 'bit_rate': 7281, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 149402, 'file_size': 135960946, 'height': 640, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_640x640', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/47184/mp4_640x640/1502490038_00001.png', 'url': 'https://vid.tasty.co/output/47184/mp4_640x640/1502490038', 'width': 640}, {'aspect': 'square', 'bit_rate': 7303, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 149402, 'file_size': 136368576, '