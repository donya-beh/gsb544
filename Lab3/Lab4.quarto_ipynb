   "source": [
    "---\n",
    "title: \"Lab 4\"\n",
    "author: \"Donya Behroozi\"\n",
    "format: html\n",
    "embed-resources: true\n",
    "code-fold: true\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "217754f7",
   "metadata": {},
   "source": [
    "# 1. Data from unstructured websites\n",
    "\n",
    "## Load necessary libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "62cf9f43",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "import re\n",
    "from plotnine import *"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6d913fc6",
   "metadata": {},
   "source": [
    "## Scrape data\n",
    "Read in HTML from URL using `requests` library."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "75dd1cff",
   "metadata": {},
   "outputs": [],
   "source": [
    "URL = \"https://tastesbetterfromscratch.com/meal-plan-142/\"\n",
    "HEADERS = {\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64)\"}\n",
    "\n",
    "response = requests.get(URL, headers=HEADERS)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6fbbe6ae",
   "metadata": {},
   "source": [
    "Use Beautiful Soup to parse into a tree."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9b0a1fd7",
   "metadata": {},
   "outputs": [],
   "source": [
    "soup = BeautifulSoup(response.text, \"html.parser\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5b416b6b",
   "metadata": {},
   "source": [
    "Find all recipe blocks."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2d2c250c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[<p class=\"has-text-align-left\"><strong>Monday</strong>: <a href=\"https://tastesbetterfromscratch.com/meatballs-arrabbiata/\">Meatballs Arrabbiata</a> $27.81</p>,\n",
       " <p class=\"has-text-align-left\"><strong>Tuesday: </strong><a href=\"https://tastesbetterfromscratch.com/leek-and-potato-soup/\">Leek &amp; Potato Soup</a> $17.93</p>,\n",
       " <p class=\"has-text-align-left\"><strong>Wednesday: </strong><a href=\"https://tastesbetterfromscratch.com/gyros/\">Gyros</a> $26.58</p>,\n",
       " <p class=\"has-text-align-left\"><strong>Thursday: </strong><a href=\"https://tastesbetterfromscratch.com/chicken-tinga/\">Chicken Tinga Tostadas</a> $10.22</p>,\n",
       " <p class=\"has-text-align-left\"><strong>Friday: </strong><a href=\"https://tastesbetterfromscratch.com/one-pan-baked-ziti/\">Baked Ziti</a> $7.42</p>]"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "recipes = soup.find_all(\"p\", class_ = \"has-text-align-left\")\n",
    "recipes"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "93c3cfe0",
   "metadata": {},
   "source": [
    "## Create columns of data frame"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "27428cec",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/html": [
       "<div>\n",
       "<style scoped>\n",
       "    .dataframe tbody tr th:only-of-type {\n",
       "        vertical-align: middle;\n",
       "    }\n",
       "\n",
       "    .dataframe tbody tr th {\n",
       "        vertical-align: top;\n",
       "    }\n",
       "\n",
       "    .dataframe thead th {\n",
       "        text-align: right;\n",
       "    }\n",
       "</style>\n",
       "<table border=\"1\" class=\"dataframe\">\n",
       "  <thead>\n",
       "    <tr style=\"text-align: right;\">\n",
       "      <th></th>\n",
       "      <th>Day of the Week</th>\n",
       "      <th>Name of Recipe</th>\n",
       "      <th>Link to Recipe</th>\n",
       "      <th>Price of Recipe</th>\n",
       "    </tr>\n",
       "  </thead>\n",
       "  <tbody>\n",
       "    <tr>\n",
       "      <th>0</th>\n",
       "      <td>Monday</td>\n",
       "      <td>Meatballs Arrabbiata</td>\n",
       "      <td>https://tastesbetterfromscratch.com/meatballs-...</td>\n",
       "      <td>27.81</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>1</th>\n",
       "      <td>Tuesday</td>\n",
       "      <td>Leek &amp; Potato Soup</td>\n",
       "      <td>https://tastesbetterfromscratch.com/leek-and-p...</td>\n",
       "      <td>17.93</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>2</th>\n",
       "      <td>Wednesday</td>\n",
       "      <td>Gyros</td>\n",
       "      <td>https://tastesbetterfromscratch.com/gyros/</td>\n",
       "      <td>26.58</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>3</th>\n",
       "      <td>Thursday</td>\n",
       "      <td>Chicken Tinga Tostadas</td>\n",
       "      <td>https://tastesbetterfromscratch.com/chicken-ti...</td>\n",
       "      <td>10.22</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>4</th>\n",
       "      <td>Friday</td>\n",
       "      <td>Baked Ziti</td>\n",
       "      <td>https://tastesbetterfromscratch.com/one-pan-ba...</td>\n",
       "      <td>7.42</td>\n",
       "    </tr>\n",
       "  </tbody>\n",
       "</table>\n",
       "</div>"
      ],
      "text/plain": [
       "  Day of the Week          Name of Recipe  \\\n",
       "0          Monday    Meatballs Arrabbiata   \n",
       "1         Tuesday      Leek & Potato Soup   \n",
       "2       Wednesday                   Gyros   \n",
       "3        Thursday  Chicken Tinga Tostadas   \n",
       "4          Friday              Baked Ziti   \n",
       "\n",
       "                                      Link to Recipe Price of Recipe  \n",
       "0  https://tastesbetterfromscratch.com/meatballs-...           27.81  \n",
       "1  https://tastesbetterfromscratch.com/leek-and-p...           17.93  \n",
       "2         https://tastesbetterfromscratch.com/gyros/           26.58  \n",
       "3  https://tastesbetterfromscratch.com/chicken-ti...           10.22  \n",
       "4  https://tastesbetterfromscratch.com/one-pan-ba...            7.42  "
      ]
     },
     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "rows = []\n",
    "for i in soup.find_all(\"p\", class_ = \"has-text-align-left\"):\n",
    "\n",
    "    # day of week\n",
    "    day_string = i.text\n",
    "    day = \"\".join(re.findall(r\"\\w+(?=: )\", day_string))\n",
    "\n",
    "    # name of recipe\n",
    "    name_tag = i.find(\"a\")\n",
    "    name = name_tag.text\n",
    "\n",
    "    # link to recipe\n",
    "    link_tag = i.find(\"a\")\n",
    "    link = link_tag.get(\"href\")\n",
    "\n",
    "    # price of recipe\n",
    "    price = \"\".join(re.findall(r\"\\d+.\\d{2}\", day_string))\n",
    "\n",
    "    # append the data\n",
    "    rows.append({\n",
    "        \"Day of the Week\": day,\n",
    "        \"Name of Recipe\": name,\n",
    "        \"Link to Recipe\": link,\n",
    "        \"Price of Recipe\": price\n",
    "    })\n",
    "\n",
    "meals_data = pd.DataFrame(rows)\n",
    "meals_data"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e930f27a",
   "metadata": {},
   "source": [
