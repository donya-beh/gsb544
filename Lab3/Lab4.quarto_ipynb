 'One-Pot Recipes', 'slug': 'one-pot'}, {'name': 'Romantic Dinners', 'slug': 'romantic-dinners'}, {'name': 'Dinner', 'slug': 'dinner'}, {'name': 'Pasta', 'slug': 'pasta'}, {'name': 'Italian', 'slug': 'italian'}], 'total_time_minutes': 0, 'total_time_tier': None, 'updated_at': 1683237600, 'user_ratings': {'count_negative': 6, 'count_positive': 39, 'score': 0.8666666666666667}, 'video_ad_content': None, 'video_id': None, 'video_url': None, 'yields': '6-8 Servings'}, {'approved_at': 1495934007, 'aspect_ratio': '1:1', 'beauty_url': None, 'brand': None, 'brand_id': None, 'buzz_id': None, 'canonical_id': 'recipe:112', 'compilations': [{'approved_at': 1580777511, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1388', 'country': 'US', 'created_at': 1580453851, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 1388, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '11 Deliciously Epic Meatball Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '11-deliciously-epic-meatball-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/253648.jpg', 'video_id': 99735, 'video_url': 'https://vid.tasty.co/output/159047/hls24_1580453958.m3u8'}, {'approved_at': 1612359552, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2104', 'country': 'US', 'created_at': 1611862367, 'description': 'Looking for some delicious teriyaki recipes for your weekend dinner? We\\'ve curated some of the absolute best ones. Start with a crowd favorite: <a href=\"https://tasty.co/recipe/chicken-teriyaki-crispy-noodle-bowl\">Chicken Teriyaki Crispy Noodles</a>. Or whip up some <a href=\"https://tasty.co/recipe/slow-cooker-chicken-teriyaki\">Slow Cooker Chicken Teriyaki</a> if you really want to elevate and impress. If you\\'re vegetarian or vegan, no problem. You can always swap meat with the vegetable of your choice, or even tofu. So, pick your favorite and let\\'s get cooking!', 'draft_status': 'published', 'facebook_posts': [], 'id': 2104, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Teriyaki Dinners ', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'teriyaki-dinners', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/304920.jpg', 'video_id': 123369, 'video_url': 'https://vid.tasty.co/output/191619/hls24_1611862668.m3u8'}, {'approved_at': 1652970321, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:3166', 'country': 'US', 'created_at': 1652425041, 'description': 'Meatballs are easy and fun to make from scratch and they\\'re perfect for all of your favorite recipes! You can pair them with spaghetti, sandwiches, soups, and game-day snacks! We are here to share some amazing meatball recipes with you! Try out our <a href=\"https://tasty.co/recipe/cheesy-meatball-bake\">Cheesy Meatball Bake</a> and these cheesy and crispy. <a href=\"https://tasty.co/recipe/meatball-mozzarella-sticks\">Meatball Mozzarella Sticks</a> that will make you the King or Queen of meatballs!', 'draft_status': 'published', 'facebook_posts': [], 'id': 3166, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Meatballs For Everyone!', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'meatballs-for-everyone', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/377777.jpg', 'video_id': 157501, 'video_url': 'https://vid.tasty.co/output/239268/hls24_1652425377.m3u8'}], 'cook_time_minutes': 25, 'country': 'US', 'created_at': 1493235945, 'credits': [{'is_verified': False, 'name': None, 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': 'These chicken teriyaki meatballs are a tasty twist on a classic dish. Made with ground chicken, teriyaki sauce, and green onions, they are a delicious and easy meal that the whole family will love. Serve them with rice and steamed vegetables for a complete meal.', 'draft_status': 'published', 'facebook_posts': [], 'id': 112, 'inspired_by_url': None, 'instructions': [{'appliance': 'oven', 'display_text': 'Preheat the oven to 400ºF (200ºC). Line a baking sheet with parchment paper and set aside.', 'end_time': 0, 'id': 839, 'position': 1, 'start_time': 0, 'temperature': 400}, {'appliance': None, 'display_text': 'Combine all ingredients for the meatballs in a bowl.', 'end_time': 8967, 'id': 840, 'position': 2, 'start_time': 1000, 'temperature': None}, {'appliance': None, 'display_text': 'Mix until all ingredients are well-blended.', 'end_time': 11817, 'id': 8623, 'position': 3, 'start_time': 9967, 'temperature': None}, {'appliance': None, 'display_text': 'Use an ice cream scoop or a spoon and form into meatballs. Place on the baking sheet.', 'end_time': 16767, 'id': 8624, 'position': 4, 'start_time': 13117, 'temperature': None}, {'appliance': None, 'display_text': 'Bake for 20-25 minutes (until lightly browned and the chicken is cooked through).', 'end_time': 0, 'hacks': [{'end_index': 44, 'id': 13, 'match': 'browned', 'start_index': 38}, {'end_index': 78, 'id': 21, 'match': 'cooked through', 'start_index': 65}], 'id': 8625, 'position': 5, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'In the meantime, prepare the glaze! Pour soy sauce, rice vinegar, sesame oil, honey, sriracha, garlic, ginger, and brown sugar into a sauce pan.', 'end_time': 32217, 'id': 841, 'position': 6, 'start_time': 20317, 'temperature': None}, {'appliance': None, 'display_text': 'Turn on medium heat, and stir until the sugar has dissolved.', 'end_time': 34617, 'id': 8628, 'position': 7, 'start_time': 32467, 'temperature': None}, {'appliance': None, 'display_text': 'Then, pour in the cornstarch slurry and whisk until the sauce has thickened (about 5 minutes).', 'end_time': 40617, 'hacks': [{'end_index': 44, 'id': 24, 'match': 'whisk', 'start_index': 40}], 'id': 8626, 'position': 8, 'start_time': 35317, 'temperature': None}, {'appliance': None, 'display_text': 'Add the meatballs to the sauce pan and evenly coat them with the teriyaki glaze.', 'end_time': 45117, 'id': 8629, 'position': 9, 'start_time': 41317, 'temperature': None}, {'appliance': None, 'display_text': 'Serve over rice or serve on their own! Garnish with Scallions and Sesame Seeds.', 'end_time': 47516, 'id': 842, 'position': 10, 'start_time': 45817, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 50449, 'id': 8627, 'position': 11, 'start_time': 48667, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': None, 'language': 'eng', 'name': 'Chicken Teriyaki Meatballs', 'num_servings': 3, 'nutrition': {'calories': 599, 'carbohydrates': 60, 'fat': 21, 'fiber': 1, 'protein': 43, 'sugar': 34, 'updated_at': '2024-09-03T03:10:44+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/0a141c1aa4f6487a826145ec734d3fdf/BFV4550_ChickenTeriyakiMeatballs_FBexport1080sq.mp4', 'prep_time_minutes': 15, 'price': {'consumption_portion': 200, 'consumption_total': 550, 'portion': 650, 'total': 2000, 'updated_at': '2025-10-26T06:14:54+01:00'}, 'promotion': 'full', 'renditions': [{'aspect': 'square', 'bit_rate': 7256, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 53188, 'file_size': 48238972, 'height': 720, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_720x720', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/32237/mp4_1280X720/1495125511_00001.png', 'url': 'https://vid.tasty.co/output/32237/mp4_1280X720/1495125511', 'width': 720}, {'aspect': 'square', 'bit_rate': None, 'container': 'mp4', 'content_type': 'application/vnd.apple.mpegurl', 'duration': 53129, 'file_size': No