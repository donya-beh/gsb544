t-1/video-api/assets/151657.jpg', 'tips_and_ratings_enabled': True, 'tips_summary': {'by_line': 'Powered By Botatouille', 'content': '• Add olives for a savory kick 🫒\\n• Stuff those meatballs with cheese for a gooey surprise 🧀\\n• Experiment with different doughs like croissant rolls or homemade pizza dough 🍞\\n• Make smaller meatballs to keep the pizza from being overrun 🍕\\n• Marinate the ground beef for a few hours to amp up the flavor 🌶️', 'header': 'Highlights'}, 'topics': [{'name': 'Bread Lovers', 'slug': 'bread'}, {'name': 'Easy Dinner', 'slug': 'easy-dinner'}, {'name': 'Kid Friendly', 'slug': 'kid-friendly'}, {'name': 'One-Pot Recipes', 'slug': 'one-pot'}, {'name': 'Dinner', 'slug': 'dinner'}, {'name': 'Snacks', 'slug': 'snacks'}, {'name': 'American', 'slug': 'american'}, {'name': 'Italian', 'slug': 'italian'}], 'total_time_minutes': 60, 'total_time_tier': {'display_tier': 'Under 1 hour', 'tier': 'under_1_hour'}, 'updated_at': 1560117600, 'user_ratings': {'count_negative': 8, 'count_positive': 87, 'score': 0.9157894736842105}, 'video_ad_content': 'none', 'video_id': 53609, 'video_url': 'https://vid.tasty.co/output/90768/hls24_1524529502.m3u8', 'yields': 'Servings: 3-5'}, {'approved_at': 1498534695, 'aspect_ratio': '1:1', 'beauty_url': None, 'brand': None, 'brand_id': None, 'buzz_id': None, 'canonical_id': 'recipe:800', 'compilations': [{'approved_at': 1513291118, 'aspect_ratio': None, 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:339', 'country': 'US', 'created_at': 1513279639, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 339, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '4 Easy Veggie-Packed Dinners', 'promotion': 'full', 'show': [{'id': 34, 'name': 'Goodful'}], 'slug': '4-easy-veggie-packed-dinners', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/2408feffaefa4f9a8192ccd198b9f089/BFV34968_HiddenVeggies4Ways_FB_FINAL.jpg', 'video_id': 41196, 'video_url': 'https://vid.tasty.co/output/68006/hls24_1513273977.m3u8'}, {'approved_at': 1624392827, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2489', 'country': 'US', 'created_at': 1622445383, 'description': 'Kids don\\'t always love veggies, we know. But luckily, with our carefully curated list of hidden veggie recipes, getting those kiddos to eat their greens will be a piece of cake! Test out our <a href=\"https://tasty.co/recipe/hidden-veggie-burgers\">Hidden Veggie Burger</a> for a scrumptious lunch, or serve up a crowd-pleasing <a href=\"https://tasty.co/recipe/hidden-veggie-mac-cheese\">Mac \\'n\\' Cheese</a> with a veggie-laden twist – they\\'ll never know the differencel And don\\'t you worry, your secret is safe with us. ', 'draft_status': 'published', 'facebook_posts': [], 'id': 2489, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Hidden Veggie Recipes Kids Will Love!', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'hidden-veggie-recipes-kids-will-love', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/324813.jpg', 'video_id': 132945, 'video_url': 'https://vid.tasty.co/output/204587/hls24_1622445717.m3u8'}], 'cook_time_minutes': 35, 'country': 'US', 'created_at': 1493236067, 'credits': [{'is_verified': False, 'name': 'Claire Nolan', 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"These meatballs are a sneaky way to get your veggies in, with finely shredded zucchini and carrot mixed right in with the ground meat. They're moist, tender, and bursting with flavor, and are perfect served over a bed of spaghetti with some extra sauce on top.\", 'draft_status': 'published', 'facebook_posts': [], 'id': 800, 'inspired_by_url': None, 'instructions': [{'appliance': None, 'display_text': 'Place the shredded carrot and zucchini on a clean towel and wring out as much liquid as possible.', 'end_time': 16000, 'id': 5601, 'position': 1, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Add the carrot and zucchini to a large bowl, along with the ground beef, ground pork, Parmesan, onion, parsley, salt, pepper, garlic powder, eggs, and bread crumbs. Mix until just combined.', 'end_time': 33000, 'id': 5602, 'position': 2, 'start_time': 19000, 'temperature': None}, {'appliance': None, 'display_text': 'Scoop about ¼ cup of the meat mixture at a time and roll into balls.', 'end_time': 35667, 'id': 5603, 'position': 3, 'start_time': 34000, 'temperature': None}, {'appliance': 'oven', 'display_text': 'Pan-fry the meatballs in a large nonstick pan over medium-high heat until all sides are golden brown, about 10 minutes, then add the marinara sauce and simmer for 10-15 minutes. Alternatively, bake the meatballs on a parchment-lined baking sheet at 350˚F (180˚C) for 30-35 minutes, flipping after the first 15 minutes. Warm up marinara sauce and serve on the side.', 'end_time': 50000, 'hacks': [{'end_index': 157, 'id': 17, 'match': 'simmer', 'start_index': 152}, {'end_index': 6, 'id': 19, 'match': 'fry', 'start_index': 4}], 'id': 5604, 'position': 4, 'start_time': 37000, 'temperature': 250}, {'appliance': None, 'display_text': 'Serve the meatballs with cooked spaghetti and Parmesan cheese.', 'end_time': 55000, 'id': 5605, 'position': 5, 'start_time': 52000, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 64000, 'id': 5606, 'position': 6, 'start_time': 59000, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': 'buzzfeed, carrots, delicious, dinner, easy, hidden, hidden veggie, meatballs, nom, secret veggie, spaghetti, tasty, tasty jr, zucchini', 'language': 'eng', 'name': 'Hidden Veggie Meatballs', 'num_servings': 7, 'nutrition': {'calories': 759, 'carbohydrates': 71, 'fat': 29, 'fiber': 4, 'protein': 49, 'sugar': 5, 'updated_