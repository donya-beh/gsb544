t_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Mix ground beef, pork, egg, parsley, breadcrumbs, salt, and pepper until evenly combined.', 'end_time': 24000, 'id': 26283, 'position': 2, 'start_time': 12000, 'temperature': None}, {'appliance': None, 'display_text': 'Take a golf ball-sized handful of the meatball mixture and press it flat in the palm of your hand.', 'end_time': 28000, 'id': 26284, 'position': 3, 'start_time': 24000, 'temperature': None}, {'appliance': None, 'display_text': 'Place a spoonful of the spinach dip in the center of the meat and fold the edges over the dip, sealing it and rolling into a ball.', 'end_time': 35000, 'id': 26285, 'position': 4, 'start_time': 30000, 'temperature': None}, {'appliance': None, 'display_text': 'Repeat with the remaining meat and dip.', 'end_time': 0, 'id': 26286, 'position': 5, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'In a pan over medium-high heat, sear meatballs for about a minute, then flip.', 'end_time': 41400, 'id': 26287, 'position': 6, 'start_time': 37000, 'temperature': None}, {'appliance': None, 'display_text': 'Add the marinara sauce and mix.', 'end_time': 45850, 'id': 26288, 'position': 7, 'start_time': 41830, 'temperature': None}, {'appliance': None, 'display_text': 'Cook for about 15 minutes, until meatballs are cooked through and sauce is thick.', 'end_time': 49380, 'hacks': [{'end_index': 60, 'id': 21, 'match': 'cooked through', 'start_index': 47}], 'id': 26289, 'position': 8, 'start_time': 45851, 'temperature': None}, {'appliance': None, 'display_text': 'Serve with fettuccine.', 'end_time': 55979, 'id': 26290, 'position': 9, 'start_time': 49381, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 60860, 'id': 26355, 'position': 10, 'start_time': 56000, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': None, 'language': 'eng', 'name': '