t': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/253648.jpg', 'video_id': 99735, 'video_url': 'https://vid.tasty.co/output/159047/hls24_1580453958.m3u8'}, {'approved_at': 1612359552, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2104', 'country': 'US', 'created_at': 1611862367, 'description': 'Looking for some delicious teriyaki recipes for your weekend dinner? We\\'ve curated some of the absolute best ones. Start with a crowd favorite: <a href=\"https://tasty.co/recipe/chicken-teriyaki-crispy-noodle-bowl\">Chicken Teriyaki Crispy Noodles</a>. Or whip up some <a href=\"https://tasty.co/recipe/slow-cooker-chicken-teriyaki\">Slow Cooker Chicken Teriyaki</a> if you really want to elevate and impress. If you\\'re vegetarian or vegan, no problem. You can always swap meat with the vegetable of your choice, or even tofu. So, pick your favorite and let\\'s get cooking!', 'draft_status': 'published', 'facebook_posts': [], 'id': 2104, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Teriyaki Dinners ', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'teriyaki-dinners', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/304920.jpg', 'video_id': 123369, 'video_url': 'https://vid.tasty.co/output/191619/hls24_1611862668.m3u8'}, {'approved_at': 1635864464, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2908', 'country': 'US', 'created_at': 1635420000, 'description': 'Everyone loves meatballs, and these easy recipes will make you a meatball expert in no time. Our <a href=\"https://tasty.co/recipe/teriyaki-meatballs\">teriyaki meatballs</a> are the perfect blend of sweet and savory, and we absolutely love these <a href=\"https://tasty.co/recipe/bbq-bacon-onion-meatball-bomb\">BBQ bacon and onion-wrapped meatballs</a>. Looking for something to impress a crowd? Give our <a href=\"https://tasty.co/recipe/giant-spaghetti-stuffed-meatball\">giant spaghetti-stuffed meatball</a> a go. It’s always a crowd favorite.', 'draft_status': 'published', 'facebook_posts': [], 'id': 2908, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Homemade Fancy Meatball Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'homemade-fancy-meatball-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/349526.jpg', 'video_id': 143754, 'video_url': 'https://vid.tasty.co/output/220430/hls24_1635419991.m3u8'}], 'cook_time_minutes': 20, 'country': 'ZZ', 'created_at': 1502485660, 'credits': [{'is_verified': False, 'name': 'Matthew Johnson', 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"These meatballs are the real MVPs of any party spread. With a sticky-sweet teriyaki glaze and a juicy, tender center, they're a crowd-pleaser that will have everyone coming back for seconds (and thirds, and fourths...). Just be sure to make plenty, because they go fast!\", 'draft_status': 'published', 'facebook_posts': [], 'id': 2270, 'inspired_by_url': 'http://damndelicious.net/2014/03/08/teriyaki-meatballs/', 'instructions': [{'appliance': 'oven', 'display_text': 'Preheat oven to 425°F (220°C).', 'end_time': 0, 'id': 19069, 'position': 1, 'start_time': 0, 'temperature': 425}, {'appliance': None, 'display_text': 'In a medium-size bowl mix together the beef, pork, bread crumbs, onion, parsley, garlic, eggs, salt, and pepper until just combined.', 'end_time': 13500, 'id': 19070, 'position': 2, 'start_time': 3500, 'temperature': None}, {'appliance': None, 'display_text': 'Take a walnut size of the meat mixture and roll into a ball. Repeat with remaining meat and transfer to an oiled rack on a sheet tray.', 'end_time': 19000, 'id': 19071, 'position': 3, 'start_time': 14500, 'temperature': None}, {'appliance': None, 'display_text': 'Bake meatballs for 15 minutes, until golden brown. Set aside.', 'end_time': 21000, 'id': 19072, 'position': 4, 'start_time': 20000, 'temperature': None}, {'appliance': None, 'display_text': 'In a pan on medium high heat, add the mirin, garlic, ginger, soy sauce, and sugar. Stir the mixture and bring to a simmer for 5 minutes.', 'end_time': 95000, 'hacks': [{'end_index': 120, 'id': 17, 'match': 'simmer', 'start_index': 115}], 'id': 19073, 'position': 5, 'start_time': 83000, 'temperature': None}, {'appliance': None, 'display_text': 'Add the meatballs and coat them with the sauce.', 'end_time': 98400, 'id': 19074, 'position': 6, 'start_time': 96000, 'temperature': None}, {'appliance': None, 'display_text': 'Sprinkle with the sesame seeds and scallions, poke with toothpicks, and serve!', 'end_time': 104500, 'id': 19075, 'position': 7, 'start_time': 99400, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 107000, 'id': 19076, 'position': 8, 'start_time': 105500, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': ', balls, barbecue, bbq, beef, best, best ever, buzzfeed, cheese, cheesy, classic, cocktail, cook, easy, food, galzed yum, garlic, ginger, glaxe, honey, how to, marinara, meatball, meatballs, mini, onion, parm, parmsean, party meatballs, perfect, pork, recipe, sauce, saucy, sesame, soy, swedish, tasty, teriyaki, tomato, toothpick, ultimate, yummy', 'language': 'und', 'name': 'Teriyaki Meatballs', 'num_servings': 40, 'nutrition': {'calories': 87, 'carbohydrates': 4, 'fat': 4, 'fiber': 0, 'protein': 7, 'sugar': 1, 'updated_at': '2024-09-03T03:10:44+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/8f9e929d3d334bdeb60d65085358367e/FB_05_for_Final.mp4', 'prep_time_minutes': 25, 'price': {'consumption_portion': 50, 'consumption_total': 1250, 'portion': 50, 'total': 2600, 'updated_at': '2025-10-26T0