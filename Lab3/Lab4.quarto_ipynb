_plural': 'g', 'display_singular': 'g', 'name': 'gram', 'system': 'metric'}}], 'position': 16, 'raw_text': '1 pound ground pork'}, {'extra_comment': 'plus more to taste', 'id': 52681, 'ingredient': {'created_at': 1493307153, 'display_plural': 'kosher salts', 'display_singular': 'kosher salt', 'id': 11, 'name': 'kosher salt', 'updated_at': 1509035289}, 'measurements': [{'id': 789959, 'quantity': '½', 'unit': {'abbreviation': 'tsp', 'display_plural': 'teaspoons', 'display_singular': 'teaspoon', 'name': 'teaspoon', 'system': 'imperial'}}], 'position': 17, 'raw_text': '½ teaspoon kosher salt, plus more to taste'}, {'extra_comment': '', 'id': 52682, 'ingredient': {'created_at': 1554173408, 'display_plural': '85% lean ground beefs', 'display_singular': '85% lean ground beef', 'id': 5264, 'name': '85% lean ground beef', 'updated_at': 1554173408}, 'measurements': [{'id': 789941, 'quantity': '1', 'unit': {'abbreviation': 'lb', 'display_plural': 'lb', 'display_singular': 'lb', 'name': 'pound', 'system': 'imperial'}}, {'id': 789939, 'quantity': '455', 'unit': {'abbreviation': 'g', 'display_plural': 'g', 'display_singular': 'g', 'name': 'gram', 'system': 'metric'}}], 'position': 18, 'raw_text': '1 pound 85% lean ground beef'}, {'extra_comment': '', 'id': 52683, 'ingredient': {'created_at': 1553568771, 'display_plural': 'McCormick® Savory Spice Blends', 'display_singular': 'McCormick® Savory Spice Blend', 'id': 5237, 'name': 'McCormick® Savory Spice Blend', 'updated_at': 1553568771}, 'measurements': [{'id': 789950, 'quantity': '1', 'unit': {'abbreviation': 'tbsp', 'display_plural': 'tablespoons', 'display_singular': 'tablespoon', 'name': 'tablespoon', 'system': 'imperial'}}], 'position': 19, 'raw_text': '1 tablespoon McCormick® Savory Spice Blend'}, {'extra_comment': 'to taste', 'id': 52684, 'ingredient': {'created_at': 1493306183, 'display_plural': 'olive oils', 'display_singular': 'olive oil', 'id': 4, 'name': 'olive oil', 'updated_at': 1509035290}, 'measurements': [{'id': 789