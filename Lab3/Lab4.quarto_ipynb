'}, {'name': 'Romantic Dinners', 'slug': 'romantic-dinners'}, {'name': 'Dinner', 'slug': 'dinner'}, {'name': 'Pasta', 'slug': 'pasta'}], 'total_time_minutes': 32, 'total_time_tier': {'display_tier': 'Under 45 minutes', 'tier': 'under_45_minutes'}, 'updated_at': 1683237600, 'user_ratings': {'count_negative': 492, 'count_positive': 8329, 'score': 0.9442240108831198}, 'video_ad_content': 'none', 'video_id': 5923, 'video_url': 'https://vid.tasty.co/output/31947/low_1495124918.m3u8', 'yields': 'Servings'}, {'approved_at': 1503930323, 'aspect_ratio': '1:1', 'beauty_url': None, 'brand': None, 'brand_id': None, 'buzz_id': 4616255, 'canonical_id': 'recipe:2347', 'compilations': [{'approved_at': 1603805558, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1758', 'country': 'US', 'created_at': 1603278418, 'description': \"If you're someone who never gets tired of noodles, prep yourself a week of these meals that feature unique noodle dishes from around the world. Slurp on some classic spaghetti with meatballs, or go fancy with a bowl of ramen. Either ways don't forget to keep your forks or chopsticks ready. \", 'draft_status': 'published', 'facebook_posts': [], 'id': 1758, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Noodle Recipes For Each Day Of The Week', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'noodle-recipes-for-each-day-of-the-week', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/287050.jpg', 'video_id': 115334, 'video_url': 'https://vid.tasty.co/output/181462/hls24_1602508977.m3u8'}, {'approved_at': 1604326500, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1764', 'country': 'US', 'created_at': 1603872968, 'description': 'With the fall season in full swing, we\\'re here with our best lunch recipes! These recipes are great for an elaborate family lunch. Take your pick from a classic <a href=\"https://tasty.co/recipe/turkey-skillet-pot-pie-with-buttermilk-biscuits\">Turkey Skillet Pot Pie</a> or <a href=\"https://tasty.co/recipe/slow-roasted-honey-glazed-pork\">Slow Roasted Honey Glazed Pork</a>. We promise you that these recipes are sure to impress everyone. So, grab your apron, and let’s get cookin’!', 'draft_status': 'published', 'facebook_posts': [], 'id': 1764, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Fall Lunches ', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'fall-lunches', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/282013.jpg', 'video_id': 113059, 'video_url': 'https://vid.tasty.co/output/183155/hls24_1603873343.m3u8'}, {'approved_at': 1675987256, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:3510', 'country': 'US', 'created_at': 1675864976, 'description': 'Why not cook up some delicious pasta dishes for that special someone this Valentine\\'s Day? We guarantee they\\'ll love you for it! Try our extremely tasty <a href=\"https://tasty.co/recipe/shrimp-bacon-spinach-alfredo\">Shrimp Spinach Bacon Alfredo</a>, rich<a href=\"https://tasty.co/recipe/italian-style-bolognese-ragu\">Italian-Style Bolognese (Ragú)</a>, or keep it classic with <a href=\"https://tasty.co/recipe/simple-spaghetti-and-meatballs\">Simple Spaghetti and Meatballs!</a>', 'draft_status': 'published', 'facebook_posts': [], 'id': 3510, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': \"6 Romantic Valentine's Day Pasta Recipes!\", 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'valentines-day-pasta-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/425264.jpg', 'video_id': 180906, 'video_url': 'https://vid.tasty.co/output/272260/hls24_1675864970.m3u8'}], 'cook_time_minutes': 61, 'country': 'US', 'created_at': 1503426446, 'credits': [{'is_verified': False, 'name': 'Nathan Ng', 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': 'This classic spaghetti and meatballs recipe is simple and delicious. The meatballs are made with a mixture of ground beef and pork, and the tomato sauce is loaded with flavor.', 'draft_status': 'published', 'facebook_posts': [], 'id': 2347, 'inspired_by_url': 'http://www.thekitchn.com/marcella-hazans-amazing-4ingre-144538', 'instructions': [{'appliance': 'oven', 'display_text': 'Preheat the oven to 400˚F (200˚C).', 'end_time': 0, 'id': 19610, 'position': 1, 'start_time': 0, 'temperature': 400}, {'appliance': 'stovetop', 'display_text': 'Add the crushed tomatoes, butter, onion, and salt to a pot and bring to a simmer over medium heat.', 'end_time': 11480, 'hacks': [{'end_index': 79, 'id': 17, 'match': 'simmer', 'start_index': 74}], 'id': 19611, 'position': 2, 'start_time': 5090, 'temperature': 300}, {'appliance': 'stovetop', 'display_text': 'Lower the heat and cook for 45 minutes, until the onions are soft and starting to break apart. Remove onion.', 'end_time': 18700, 'id': 19698, 'position': 3, 'start_time': 12310, 'temperature': 200}, {'appliance': None, 'display_text': 'In a bowl, mix the ground beef, ground pork, panko, Parmesan, egg, garlic, onion, Worcestershire, salt, pepper, and parsley until fully combined.', 'end_time': 34420, 'id': 19612, 'position': 4, 'start_time': 19830, 'temperature': None}, {'appliance': None, 'display_text': 'Take a golf ball-sized handful of the meat mixture and roll it into a ball. Transfer to a baking sheet. Repeat with the remaining meat.', 'end_time': 38630, 'id': 19613, 'position': 5, 'start_time': 35570, 'temperature': None}, {'appliance': None, 'display_text': 'Bake the meatballs for 16 minutes.', 'end_time': 0, 'id': 19614, 'position': 6, 'start_time': 0, 'temperature': None}, {'appliance': 'food_thermometer', 'display_text': 'Bring a pot of water to a boil, and cook the spaghetti according to the packaging instructions.', 'end_time': 0, 'hacks': [{'end_index': 29, 'id': 18, 'match': 'boil', 'start_index': 26}], 'id': 19615, 'position': 7, 'start_time': 0, 'temperature': 215}, {'appliance': None, 'display_text': 'Drain pasta and toss lightly in about a tablespoon of oil (optional).', 'end_time': 43610, 'id': 19699, 'position': 8, 'start_time': 40620, 'temperature': None}, {'appliance': None, 'display_text': 'Pour the sauce over the pasta. Transfer the cooked meatballs and top with Parmesan.', 'end_time': 49660, 'id': 19616, 'position': 9, 'start_time': 45053, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 52350, 'id': 19617, 'position': 10, 'start_time': 50510, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': None, 'language': 'eng', 'name': 'Simple Spaghetti And Meatballs', 'num_servings': 4, 'nutrition': {'calories': 1513, 'carbohydrates': 127, 'fat': 73, 'fiber': 9, 'protein': 85, 'sugar': 17, 'updated_at': '2024-09-03T03:10:44+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/2f4e5dafcbc14508bb579615582f0612/BFV27118_Spaghetti_and_Meatballs_FB_1080X1080.mp4', 'prep_time_minutes': 30, 'price': {'consumption_portion': 450, 'consumption_total': 1800, 'portion': 800, 'total': 3150, 'updated_at': '2025-10-26T06:08:56+01:00'}, 'promotion': 'full', 'renditions': [{'aspect': 'square', 'bit_rate': 7151, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 64282, 'file_size': 57454260, 'height': 720, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_720x720', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/48663/mp4_1280X720/1503427916_00001.png', 'url': 'https://vid.tasty.co/output/48663/mp4_1280X720/1503427916', 'width': 720}, {'aspect': 'square', 'bit_rate': None, 'container': 'mp4', 'content_type': 'application/vnd