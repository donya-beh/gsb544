509035289}, 'measurements': [{'id': 519258, 'quantity': '1', 'unit': {'abbreviation': 'tsp', 'display_plural': 'teaspoons', 'display_singular': 'teaspoon', 'name': 'teaspoon', 'system': 'imperial'}}], 'position': 6, 'raw_text': '1 teaspoon black pepper'}, {'extra_comment': '', 'id': 23479, 'ingredient': {'created_at': 1493307128, 'display_plural': 'garlic powders', 'display_singular': 'garlic powder', 'id': 9, 'name': 'garlic powder', 'updated_at': 1509035289}, 'measurements': [{'id': 519255, 'quantity': '1', 'unit': {'abbreviation': 'tsp', 'display_plural': 'teaspoons', 'display_singular': 'teaspoon', 'name': 'teaspoon', 'system': 'imperial'}}], 'position': 7, 'raw_text': '1 teaspoon garlic powder'}, {'extra_comment': '', 'id': 23480, 'ingredient': {'created_at': 1493307116, 'display_plural': 'onion powders', 'display_singular': 'onion powder', 'id': 8, 'name': 'onion powder', 'updated_at': 1509035289}, 'measurements': [{'id': 519256, 'quantity': '1', 'unit': {'abbreviation': 'tsp', 'display_plural': 'teaspoons', 'display_singular': 'teaspoon', 'name': 'teaspoon', 'system': 'imperial'}}], 'position': 8, 'raw_text': '1 teaspoon onion powder'}, {'extra_comment': '', 'id': 23481, 'ingredient': {'created_at': 1494880013, 'display_plural': 'shredded parmesan cheeses', 'display_singular': 'shredded parmesan cheese', 'id': 334, 'name': 'shredded parmesan cheese', 'updated_at': 1509035269}, 'measurements': [{'id': 519262, 'quantity': '⅓', 'unit': {'abbreviation': 'c', 'display_plural': 'cups', 'display_singular': 'cup', 'name': 'cup', 'system': 'imperial'}}, {'id': 519259, 'quantity': '35', 'unit': {'abbreviation': 'g', 'display_plural': 'g', 'display_singular': 'g', 'name': 'gram', 'system': 'metric'}}], 'position': 9, 'raw_text': '⅓ cup shredded Parmesan'}, {'extra_comment': '', 'id': 23482, 'ingredient': {'created_at': 1493314622, 'display_plural': 'eggs', 'display_singular': 'egg', 'id': 19, 'name': 'egg', 'updated_at': 1509035288}, 'measurements': [{'id': 519261, 'qua