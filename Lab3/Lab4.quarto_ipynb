nt', 'type': 'equipment'}, {'display_name': \"Chef's Knife\", 'id': 1280501, 'name': 'chefs_knife', 'parent_tag_name': None, 'root_tag_type': 'equipment', 'type': 'equipment'}, {'display_name': 'Cutting Board', 'id': 1280503, 'name': 'cutting_board', 'parent_tag_name': None, 'root_tag_type': 'equipment', 'type': 'equipment'}, {'display_name': 'Dry Measuring Cups', 'id': 1280507, 'name': 'dry_measuring_cups', 'parent_tag_name': None, 'root_tag_type': 'equipment', 'type': 'equipment'}, {'display_name': 'Measuring Spoons', 'id': 1280508, 'name': 'measuring_spoons', 'parent_tag_name': None, 'root_tag_type': 'equipment', 'type': 'equipment'}, {'display_name': 'Mixing Bowl', 'id': 1280510, 'name': 'mixing_bowl', 'parent_tag_name': None, 'root_tag_type': 'equipment', 'type': 'equipment'}, {'display_name': 'Under 1 Hour', 'id': 8091748, 'name': 'under_1_hour', 'parent_tag_name': 'difficulty', 'root_tag_type': 'difficulty', 'type': 'difficulty'}, {'display_name': 'High-Protein', 'id': 8091917, 'name': 'high_protein', 'parent_tag_name': 'healthy', 'root_tag_type': 'healthy', 'type': 'healthy'}, {'display_name': 'Low-Sugar', 'id': 8091918, 'name': 'low_sugar', 'parent_tag_name': 'healthy', 'root_tag_type': 'healthy', 'type': 'healthy'}, {'display_name': 'Meal', 'id': 9295813, 'name': 'meal', 'parent_tag_name': None, 'root_tag_type': 'meal', 'type': 'meal'}, {'display_name': 'Beef', 'id': 9299515, 'name': 'beef', 'parent_tag_name': 'dinner', 'root_tag_type': 'meal', 'type': 'dinner'}, {'display_name': 'Pork', 'id': 9299516, 'name': 'pork', 'parent_tag_name': 'dinner', 'root_tag_type': 'meal', 'type': 'dinner'}, {'display_name': 'Pasta', 'id': 9299522, 'name': 'pasta', 'parent_tag_name': 'dinner', 'root_tag_type': 'meal', 'type': 'dinner'}, {'display_name': 'Eggs', 'id': 10623588, 'name': 'eggs', 'parent_tag_name': 'ingredients_to_avoid', 'root_tag_type': 'ingredients_to_avoid', 'type': 'ingredients_to_avoid'}, {'display_name': 'Gluten', 'id': 10623589, 'name': 'gluten', 'parent_tag_name': 'ingredients_to_avoid', 'root_tag_type': 'ingredients_to_avoid', 'type': 'ingredients_to_avoid'}, {'display_name': 'Dairy', 'id': 10623608, 'name': 'dairy', 'parent_tag_name': 'ingredients_to_avoid', 'root_tag_type': 'ingredients_to_avoid', 'type': 'ingredients_to_avoid'}, {'display_name': 'Beef', 'id': 10623611, 'name': 'beef', 'parent_tag_name': 'ingredients_to_avoid', 'root_tag_type': 'ingredients_to_avoid', 'type': 'ingredients_to_avoid'}, {'display_name': 'Pork', 'id': 10623613, 'name': 'pork', 'parent_tag_name': 'ingredients_to_avoid', 'root_tag_type': 'ingredients_to_avoid', 'type': 'ingredients_to_avoid'}], 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/96101.jpg', 'tips_and_ratings_enabled': True, 'tips_summary': {'by_line': 'Powered By Botatouille', 'content': '• Adjust the amount of spaghetti to ensure proper meatball formation 🍝\\n• Substitute hot ground sausage with regular or mild sausage, ground beef, or ground turkey for different flavors 🌶️🥩\\n• Consider reducing the amount of salt as Parmesan cheese provides sufficient saltiness 🧂\\n• Extend cooking time or lower the heat and broil for a crispy top 🔥\\n• Take your time and be patient when forming the meatball, or make smaller individual meatballs for easier handling and serving ⏰', 'header': 'Highlights'}, 'topics': [{'name': 'Kid Friendly', 'slug': 'kid-friendly'}, {'name': 'One-Pot Recipes', 'slug': 'one-pot'}, {'name': 'Romantic Dinners', 'slug': 'romantic-dinners'}, {'name': 'Dinner', 'slug': 'dinner'}, {'name': 'Pasta', 'slug': 'pasta'}, {'name': 'Italian', 'slug': 'italian'}], 'total_time_minutes': 60, 'total_time_tier': {'display_tier': 'Under 1 hour', 'tier': 'under_1_hour'}, 'updated_at': 1683237600, 'user_ratings': {'count_negative': 26, 'count_positive': 446, 'score': 0.9449152542372882}, 'video_ad_content': 'none', 'video_id': 23880, 'video_url': 'https://vid.tasty.co/output/50462/low_1504202178.m3u8', 'yields': 'Servings: 6'}, {'approved_at': 1563370567, 'aspect_ratio': None, 'beauty_url': None, 'brand': None, 'brand_id': None, 'buzz_id': None, 'canonical_id': 'recipe:4886', 'compilations': [], 'cook_time_minutes': 0, 'country': 'US', 'created_at': 1553790287, 'credits': [{'is_verified': False, 'name': None, 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"Satisfy your cravings with this savory spaghetti and meatball dish that's bursting with flavor. This classic comfort food, inspired by Tasty.co and Rachel Ray, will have your taste buds dancing and your family asking for seconds.\", 'draft_status': 'published', 'facebook_posts': [], 'id': 4886, 'inspired_by_url': None, 'instructions': [{'appliance': None, 'display_text': 'Make the sauce: In a large pot over medium-low heat, combine the olive oil and garlic and cook until the garlic begins to sizzle very gently. Add the red pepper flakes and cook, stirring, until the garlic just begins to turn light golden in color, about 3 minutes. Add the Savory spice blend and continue to cook, stirring, for 1 minute more.', 'end_time': 0, 'id': 45058, 'position': 1, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Add the tomato paste and cook, stirring, until the paste has softened and blended with the oil and garlic mixture, about 3 minutes.', 'end_time': 0, 'id': 45059, 'position': 2, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Stir in the tomatoes and their juices and increase the heat to medium-high, bringing the to a gentle simmer. Lower the heat a bit if it’s bubbling and spitting too much. Remove the sauce from the heat.', 'end_time': 0, 'hacks': [{'end_index': 106, 'id': 17, 'match': 'simmer', 'start_index': 101}], 'id': 45060, 'position': 3, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Using an immersion blender, blend the sauce until smooth. Tip: Drape a kitchen towel over the pot to act as a cover from sauce splatters. Or, transfer the sauce to a blender and puree, then return to the pot.', 'end_time': 0, 'id': 45061, 'position': 4, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Decrease the heat to medium-low and bring the sauce to a simmer.', 'end_time': 0, 'hacks': [], 'id': 45062, 'position': 5, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Make the meatballs: In a medium bowl, combine the bread cubes, cream, parmesan, onion, garlic, and pepper. Using a fork, mash into thick paste.', 'end_time': 0, 'id': 45063, 'position': 6, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'In a large bowl, gently mix the ground pork with the salt and baking powder. Add the beef and gently stir to combine (you can also use your hands for this). Add the bread mixture, Savory spice blend, and a pinch more salt and pepper and mix until just incorporated. Rub a bit of olive oil on your hands and form the mixture into smooth, round meatballs the size of golf balls--you should have about 25 total..', 'end_time': 0, 'id': 45064, 'position': 7, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Once the meatballs are formed, gently lower each meatball into the pot of sauce. Bring to a low simmer, cover, and cook for 25-35 minutes, or until a meat thermometer inserted into a meatball reaches 165˚F (75˚C).', 'end_time': 0, 'hacks': [], 'id': 45065, 'position': 8, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'While the meatballs are cooking, bring a large pot of salted water to a boil. Cook the spaghetti according to the package instructions. Reserve 1 cup (240 ml) of pasta cooking water, then drain.', 'end_time': 0, 'hacks': [{'end_index': 75, 'id': 18, 'match': 'boil', 'start_index': 72}], 'id': 45066, 'position': 9, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'In a large bowl, toss the spaghetti with a few large spoonfuls of pasta sauce to coat, along with a few splashes of the reserved cooking water. Divide the pasta among bowls and spoon more sauce and meatballs over the pasta. Top each serving with freshly grated Parmesan and basil.', 'end_time': 0, 'id': 45067, 'position': 10, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 0, 'id': 45068, 'position': 11, 'start_time': 0, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': '', 'language': 'eng', 'name': 'Savoury Spaghetti With Meatballs', 'num_servings': 8, 'nutrition': {'calories': 695, 'carbohydrates': 51, 'fat': 33, 'fiber': 6, 'protein': 41, 'sugar': 2, 'updated_at': '2024-05-01T08:05:37+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': None, 'prep_time_minutes': 0, 'price': {'consumption_portion': 300, 'consumption_total': 2250, 'portion': 450, 'total': 3500, 'updated_at': '2025-10-26T06:15:56+01:00'}, 'promotion': 'partial', 'renditions': [], 'sections': [{'components': [{'extra_comment': '', 'id': 52666, 'ingredient': {'created_at': 1493306183, 'display_plural': 'olive oils', 'display_singular': 'olive oil', 'id': 4, 'name': 'olive oil', 'updated_at': 1509035290}, 'measurements': [{'id': 789947, 'quantity': '2', 'unit': {'abbreviation': 'tbsp', 'display_plural': 'tablespoons', 'display_singular': 'tablespoon', 'name': 'tablespoon', 'system': 'imperial'}}], 'position': 2, 'raw_text': '2 tablespoons olive oil'}, {'extra_comment': 'crushed', 'id': 52667, 'ingredient': {'created_at': 1493744766, 'display_plural': 'garlics', 'display_singular': 'garlic', 'id': 95, 'name': 'garlic', 'updated_at': 1509035285}, 'measurements': [{'id': 789962, 'quantity': '5', 'unit': {'abbreviation': 'clove', 'display_plural': 'cloves', 'display_singular': 'clove', 'name': 'clove', 'system': 'none'}}], 'position': 3, 'raw_text': '5 cloves garlic, crushed'}, {'extra_comment': '', 'id': 52668, 'ingredient'