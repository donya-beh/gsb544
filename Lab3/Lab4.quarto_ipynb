, 'slug': 'romantic-dinners'}, {'name': 'Winter Recipes', 'slug': 'winter'}, {'name': 'Dinner', 'slug': 'dinner'}, {'name': 'Pasta', 'slug': 'pasta'}, {'name': 'Italian', 'slug': 'italian'}], 'total_time_minutes': 120, 'total_time_tier': {'display_tier': 'Under 2 hours', 'tier': 'under_2_hours'}, 'updated_at': 1684101600, 'user_ratings': {'count_negative': 18, 'count_positive': 198, 'score': 0.9166666666666666}, 'video_ad_content': 'none', 'video_id': 40045, 'video_url': 'https://vid.tasty.co/output/69906/hls24_1513969508.m3u8', 'yields': 'Servings: 4-6'}, {'approved_at': 1561564073, 'aspect_ratio': '1:1', 'beauty_url': None, 'brand': None, 'brand_id': None, 'buzz_id': None, 'canonical_id': 'recipe:1184', 'compilations': [], 'cook_time_minutes': 30, 'country': 'GB', 'created_at': 1498771625, 'credits': [{'is_verified': False, 'name': 'Evelyn Liu', 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"Take a trip to flavor town with these Swedish meatball subs! Juicy meatballs, smothered in a creamy gravy and piled high on a fresh sub roll, make for the ultimate comfort food. Don't forget the napkins–things are about to get messy in the best way possible.\", 'draft_status': 'published', 'facebook_posts': [], 'id': 1184, 'inspired_by_url': None, 'instructions': [{'appliance': None, 'display_text': 'Thoroughly mix all the meatball ingredients, and shape them into golf ball-sized balls.', 'end_time': 14000, 'id': 11103, 'position': 1, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Over low to medium heat, fry all sides of the meatballs, until the meatballs are cooked through and the outsides are golden brown. It will take around 12-15 minutes.', 'end_time': 22000, 'hacks': [{'end_index': 27, 'id': 19, 'match': 'fry', 'start_index': 25}, {'end_index': 94, 'id': 21, 'match': 'cooked through', 'start_index': 81}], 'id': 11104, 'position': 2, 'start_time': 15000, 'temperature': None}, {'appliance': None, 'display_text': 'If you are making a large quantity for a party, make the meatballs in advance and reheat them in an oven for 10-15 minutes at 175°C. (When reheating, ensure the meatballs are piping hot throughout before serving.)', 'end_time': 0, 'id': 11105, 'position': 3, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'To make the cream sauce, dissolve a beef stock cube in 20 milliliters of water. Then add in cream, mustard, and Worcestershire sauce.', 'end_time': 31000, 'hacks': [{'end_index': 50, 'id': 5, 'match': 'cube', 'start_index': 47}], 'id': 11106, 'position': 4, 'start_time': 23000, 'temperature': None}, {'appliance': None, 'display_text': 'Toss the meatballs in the sauce while it reduces to a thick and creamy sauce.', 'end_time': 38000, 'id': 11107, 'position': 5, 'start_time': 32000, 'temperature': None}, {'appliance': None, 'display_text': 'Serve the meatballs in soft French sticks with sliced cucumber and lingonberry or cranberry jam.', 'end_time': 49000, 'hacks': [{'end_index': 52, 'id': 6, 'match': 'sliced', 'start_index': 47}], 'id': 11108, 'position': 6, 'start_time': 39000, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 51000, 'id': 15911, 'position': 7, 'start_time': 50000, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': 'food, how to, meatball, party, party food, recipe, sandwiches, swedish, swedish meatballs, tasty', 'language': 'eng', 'name': 'Swedish Meatball Subs', 'num_servings': 12, 'nutrition': {'calories': 422, 'carbohydrates': 55, 'fat': 15, 'fiber': 2, 'protein': 18, 'sugar': 11, 'updated_at': '2024-09-03T03:10:44+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/e17dbf7ead3d4f9ba9a316032b3ea866/cut_4.2.mp4', 'prep_time_minutes': 20, 'price': {'consumption_portion': 100, 'consumption_total': 1450, 'portion': 300, 'total': 3600, 'updated_at': '2025-10