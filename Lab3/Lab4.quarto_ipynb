   "source": [
    "# 4. Add a column with fuzzy matching"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "e2e9de99",
   "metadata": {},
   "outputs": [],
   "source": [
    "#all possible meats\n",
    "pattern = (\n",
    "    r\"\\b(\"\n",
    "    r\"[Bb]eef|[Ss]teak|[Vv]eal|[Ll]amb|[Mm]utton|[Gg]oat|[Vv]enison|\"\n",
    "    r\"[Pp]ork|[Bb]acon|[Hh]am|[Pp]rosciutto|[Ss]alami|[Ss]ausage|\"\n",
    "    r\"[Cc]horizo|[Pp]epperoni|[Mm]eatball|[Bb]risket|[Rr]ibs|\"\n",
    "    r\"[Pp]astrami|[Cc]orned [Bb]eef|[Cc]hicken|[Tt]urkey|[Dd]uck|\"\n",
    "    r\"[Gg]oose|[Qq]uail|[Hh]en|[Rr]ooster|[Pp]heasant|\"\n",
    "    r\"[Ff]ish|[Ss]almon|[Tt]una|[Cc]od|[Hh]addock|[Tt]rout|\"\n",
    "    r\"[Tt]ilapia|[Hh]alibut|[Cc]atfish|[Ss]napper|[Mm]ahi [Mm]ahi|\"\n",
    "    r\"[Ss]ardine|[Aa]nchovy|[Bb]ass|[Ss]hrimp|[Pp]rawn|[Cc]rab|\"\n",
    "    r\"[Ll]obster|[Cc]lam|[Mm]ussel|[Oo]yster|[Ss]callop|[Ss]quid|\"\n",
    "    r\"[Cc]alamari|[Oo]ctopus|[Hh]ot [Dd]og|[Jj]erky|[Bb]ologna|\"\n",
    "    r\"[Mm]ortadella|[Pp]ancetta|[Kk]ielbasa|[Ss]pam\"\n",
    "    r\")\\b\"\n",
    ")\n",
    "\n",
    "df['Veg'] = df[\"Name of Recipe\"].apply(lambda x: \"Not Vegetarian\" if re.findall(pattern, x) else \"Vegetarian\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "675f29f9",
   "metadata": {},
   "source": [
    "# 5. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "853c58bb",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": ""
     },
     "metadata": {
      "image/png": {
       "height": 480,
       "width": 672
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "#calculate nutrition as calories\n",
    "df[\"Carbs\"] = (df[\"nutrition.carbohydrates\"]*4)\n",
    "df[\"Fat\"] = (df[\"nutrition.fat\"]*9)\n",
    "df[\"Fiber\"] = (df[\"nutrition.fiber\"]*2)\n",
    "df[\"Protein\"] = (df[\"nutrition.protein\"]*4)\n",
    "df[\"Sugar\"] = (df[\"nutrition.sugar\"]*4)\n",
    "\n",
    "#summarize nutrition facts over all tasty recipes\n",
    "summary = df[[\"Name of Recipe\", \"Veg\", \"Carbs\", \"Fat\", \"Fiber\", \"Protein\", \"Sugar\"]].groupby([\"Name of Recipe\", \"Veg\"]).mean().reset_index().rename(columns={\"Veg\": \"Vegetarian\"})\n",
    "\n",
    "recipe_order = [\"Chicken Divan\",\"Beef Noodle Soup\",\"Stuffed Shells\",\"Vegetarian Stuffed Peppers\",\"Chicken Gyros\"]\n",
    "summary[\"Name of Recipe\"] = pd.Categorical(\n",
    "    summary[\"Name of Recipe\"], categories=recipe_order)\n",
    "\n",
    "long_summary = summary.melt(id_vars=[\"Name of Recipe\", \"Vegetarian\"], var_name = \"Nutrient\", value_name = \"Calories\").dropna()\n",
    "\n",
    "(ggplot(long_summary,\n",
    "    aes(\n",
    "        x = \"Name of Recipe\",\n",
    "        y = \"Calories\",\n",
    "        fill = \"Nutrient\"\n",
    "    ))\n",
    "    +\n",
    "    geom_bar(stat = \"identity\", position = \"stack\") +\n",
    "    labs(title = \"Nutrition Information Per Recipe\") +\n",
    "    theme_bw() +\n",
    "    theme(axis_text_x=element_text(rotation=45, ha='right'))\n",
    ")"
   ]
  },
