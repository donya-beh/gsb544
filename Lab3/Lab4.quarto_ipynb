   "source": [
    "# function that scrapes meal plan data\n",
    "def get_weekly_plan(plan_num):\n",
    "    URL = \"https://tastesbetterfromscratch.com/meal-plan-{}/\".format(plan_num)\n",
    "    HEADERS = {\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64)\"}\n",
    "\n",
    "    response = requests.get(URL, headers=HEADERS)\n",
    "    soup = BeautifulSoup(response.text, \"html.parser\")\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for i in soup.find_all(\"p\", class_ = \"has-text-align-left\"):\n",
    "        # day of week\n",
    "        day_string = i.text\n",
    "        day = \"\".join(re.findall(r\"\\w+(?=: )\", day_string))\n",
    "\n",
    "        # name of recipe\n",
    "        name_tag = i.find(\"a\")\n",
    "        name = name_tag.text\n",
    "\n",
    "        # link to recipe\n",
    "        link_tag = i.find(\"a\")\n",
    "        link = link_tag.get(\"href\")\n",
    "\n",
    "        # price of recipe\n",
    "        price = \"\".join(re.findall(r\"\\d+.\\d{2}\", day_string))\n",
    "\n",
    "        # append the data\n",
    "        rows.append({\n",
    "            \"Day of the Week\": day,\n",
    "            \"Name of Recipe\": name,\n",
    "            \"Link to Recipe\": link,\n",
    "            \"Price of Recipe\": price\n",
    "        })\n",
    "\n",
    "    meals_data = pd.DataFrame(rows)\n",
    "    meals_data\n",
    "    return meals_data\n",
    "\n",
    "get_weekly_plan(202)\n",
    "\n",
    "# function that searches tasty API for matching recipes\n",
    "def match_recipe(search_name):\n",
    "    url = \"https://tasty.p.rapidapi.com/recipes/list\"\n",
    "\n",
    "    querystring = {\"from\":\"0\",\"size\":\"100\",\"q\":\"{}\".format(search_name)}\n",
    "\n",
    "    headers = {\n",
    "\t    \"x-rapidapi-key\": \"a638670f82msh50c4d1549283208p17344djsnc360496a27fd\",\n",
    "\t    \"x-rapidapi-host\": \"tasty.p.rapidapi.com\"\n",
    "    }\n",
    "\n",
    "    response = requests.get(url, headers=headers, params=querystring)\n",
    "\n",
    "    tasty_recipes = pd.json_normalize(response.json(), \"results\")\n",
    "    return tasty_recipes\n",
    "\n",
    "# combine functions together\n",
    "def get_mealplan_data(num):\n",
    "    weekly_plan_data = get_weekly_plan(num)\n",
    "    \n",
    "    #loop through each recipe in weekly meal plan data and find tasty data\n",
    "    rows = []\n",
    "    for _, row in weekly_plan_data.iterrows():\n",
    "        tasty_table = match_recipe(row[\"Name of Recipe\"])\n",
    "        if tasty_table is None or tasty_table.empty:\n",
    "            tasty_table = pd.DataFrame({\"Tasty Recipe\": [pd.NA]})\n",
    "        else:\n",
    "            # rename for display; keep all other Tasty columns\n",
    "            tasty_table = tasty_table.rename(columns={\"name\": \"Tasty Recipe\"})\n",
    "        tasty_table.insert(0, \"Price of Recipe\", row[\"Price of Recipe\"])\n",
    "        tasty_table.insert(0, \"Link to Recipe\",  row[\"Link to Recipe\"])\n",
    "        tasty_table.insert(0, \"Name of Recipe\",  row[\"Name of Recipe\"])\n",
    "        tasty_table.insert(0, \"Day of the Week\",   row[\"Day of the Week\"])\n",
    "        rows.append(tasty_table)\n",
    "    complete_table = pd.concat(rows, ignore_index = True)\n",
    "    return complete_table\n",
    "\n",
    "df = get_mealplan_data(202)\n",
    "df.head"
   ]
  },
