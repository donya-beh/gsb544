'ingredients_to_avoid'}], 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/video-api-prod/assets/4b9d629a477442e0a37fb2cdd338531b/IMG_9939_fb.jpg', 'tips_and_ratings_enabled': True, 'tips_summary': {'by_line': 'Powered By Botatouille', 'content': '• Add more cheese to the meatballs, like mozzarella or garlic and herb boursin, for a melty explosion 🧀💥\\n• Try mixing beef and pork or turkey for a flavor fiesta 🎉🍖\\n• Adjust cooking time—some say bacon needs more love, while others want to keep cheese snug in the meatballs ⏰❤️\\n• Experiment with different BBQ sauces or add more sauce for a saucy adventure 🍖🔥\\n• Blend Mediterranean herb croutons into breadcrumbs for a flavor-packed twist 🌿🍞', 'header': 'Highlights'}, 'topics': [{'name': 'BBQ Season', 'slug': 'bbq'}, {'name': 'Bread Lovers', 'slug': 'bread'}, {'name': 'Easy Dinner', 'slug': 'easy-dinner'}, {'name': 'Kid Friendly', 'slug': 'kid-friendly'}, {'name': 'Romantic Dinners', 'slug': 'romantic-dinners'}, {'name': 'Dinner', 'slug': 'dinner'}, {'name': 'American', 'slug': 'american'}], 'total_time_minutes': 75, 'total_time_tier': {'display_tier': 'Under 1.5 hours', 'tier': 'under_1.5_hours'}, 'updated_at': 1683237600, 'user_ratings': {'count_negative': 12, 'count_positive': 218, 'score': 0.9478260869565217}, 'video_ad_content': 'none', 'video_id': 19011, 'video_url': 'https://vid.tasty.co/output/33249/low_1496357867.m3u8', 'yields': 'Servings: 8-12'}, {'approved_at': 1532542440, 'aspect_ratio': '1:1', 'beauty_url': 'https://img.buzzfeed.com/video-api-prod/assets/d684ecac218d412cb023073f3269fadd/Beauty.jpg', 'brand': {'id': 1, 'image_url': 'https://img.buzzfeed.com/tasty-app-user-assets-prod-us-east-1/brands/99b840a83be84c70b97b53c23b8ea39f.png', 'name': 'Palmolive', 'slug': 'palmolive'}, 'brand_id': 1, 'buzz_id': None, 'canonical_id': 'recipe:4081', 'compilations': [{'approved_at': 1538959713, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:684', 'country': 'US', 'created_at': 1538760857, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 684, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '12 Tasty Bombs', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '12-tasty-bombs', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/182396.jpg', 'video_id': 67681, 'video_url': 'https://vid.tasty.co/output/111430/hls24_1538761277.m3u8'}, {'approved_at': 1580777511, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1388', 'country': 'US', 'created_at': 1580453851, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 1388, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '11 Deliciously Epic Meatball Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '11-deliciously-epic-meatball-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/253648.jpg', 'video_id': 99735, 'video_url': 'https://vid.tasty.co/output/159047/hls24_1580453958.m3u8'}], 'cook_time_minutes': 40, 'country': 'US', 'created_at': 1529417919, 'credits': [{'id': 1, 'image_url': 'https://img.buzzfeed.com/tasty-app-user-assets-prod-us-east-1/brands/99b840a83be84c70b97b53c23b8ea39f.png', 'name': 'Palmolive', 'slug': 'palmolive', 'type': 'brand'}], 'description': 'Bite into these scrumptious Meatball Lasagna Bombs and experience a burst of cheesy goodness! Perfect for a fun twist on a classic dish, these little delights will have everyone asking for seconds.', 'draft_status': 'published', 'facebook_posts': [], 'id': 4081, 'inspired_by_url': None, 'instructions': [{'appliance': None, 'display_text': 'Marinara sauce: In a large saucepan, heat the olive oil. Add onion and garlic and saute for 5 minutes, until translucent.', 'end_time': 9666, 'hacks': [{'end_index': 86, 'id': 9, 'match': 'saute', 'start_index': 82}], 'id': 36037, 'position': 1, 'start_time': 4166, 'temperature': None}, {'appliance': None, 'display_text': 'Stir in tomatoes, salt, pepper, and basil. Simmer for 15 minutes, stirring occasionally. Remove basil sprigs and set sauce aside.', 'end_time': 16866, 'id': 36038, 'position': 2, 'start_time': 9833, 'temperature': None}, {'appliance': None, 'display_text': 'In a small bowl, stir together breadcrumbs and milk and set aside. In a large bowl, whisk together egg, parmesan, salt and pepper.', 'end_time': 28233, 'hacks': [{'end_index': 88, 'id': 24, 'match': 'whisk', 'start_index': 84}], 'id': 36041, 'position': 3, 'start_time': 17366, 'temperature': None}, {'appliance': None, 'display_text': 'Stir in ground beef, onions, and wet breadcrumbs. Combine well, but do not over-mix.', 'end_time': 33733, 'id': 37510, 'position': 4, 'start_time': 28366, 'temperature': None}, {'appliance': None, 'display_text': 'With oiled hands, roll the meat into golf-sized balls.', 'end_time': 37599, 'id': 36043, 'position': 5, 'start_time': 33900, 'temperature': None}, {'appliance': None, 'display_text': 'Heat a skillet with a drizzle of olive oil. Brown meatballs on all sides, then remove from pan.', 'end_time': 44300, 'id': 36050, 'position': 6, 'start_time': 38266, 'temperature': None}, {'appliance': 'oven', 'display_text': 'Preheat oven to 350ºF (180º C).', 'end_time': 0, 'id': 36040, 'position': 7, 'start_time': 0, 'temperature': 350}, {'appliance': None, 'display_text': 'Lay out a lasagna noodle horizontally on a cutting board. Spread a tablespoon of ricotta onto the noodle. Lay a mozzarella slice on one end of the noodle and place a meatball on top of the cheese.', 'end_time': 51166, 'hacks': [{'end_index': 127, 'id': 6, 'match': 'slice', 'start_index': 123}], 'id': 36046, 'position': 8, 'start_time': 44966, 'temperature': None}, {'appliance': None, 'display_text': 'Roll up the noodle with the meatball and cheese inside. Place meatball bomb into the baking dish, with the meatball showing. Repeat with the rest of the meatballs and noodles.', 'end_time': 53333, 'id': 36048, 'position': 9, 'start_time': 51166, 'temperature': None}, {'appliance': None, 'display_text': 'Ladle approximately ⅔rds of the marinara sauce into a 9x13-inch (23x33-cm) baking dish. Place the meatball rolls on top of the marinara sauce.', 'end_time': 57666, 'id': 36045, 'position': 10, 'start_time': 53500, 'temperature': None}, {'appliance': None, 'display_text': 'Bake dish for 25 minutes, until top is lightly browned and meatballs are cooked through completely.', 'end_time': 0, 'hacks': [{'end_index': 53, 'id': 13, 'match': 'browned', 'start_index': 47}, {'end_index': 86, 'id': 21, 'match': 'cooked through', 'start_index': 73}], 'id': 36051, 'position': 11, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Remove from oven, garnish with parsley and serve with reserved marinara on the side.', 'end_time': 62866, 'id': 36053, 'position': 12, 'start_time': 59333, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 69733, 'id': 36339, 'position': 13, 'start_time': 63033, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': None, 'language': 'eng', 'name': 'Meatball Lasagna Bombs', 'num_servings': 8, 'nutrition': {'calories': 1041, 'carbohydrates': 35, 'fat': 62, 'fiber': 3, 'protein': 72, 'sugar': 8, 'updated_at': '2024-09-03T03:10:44+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/2c578a4427e94dec8158cf6bd156322c/meatballlasagnabombs.mp4', 'prep_time_minutes': 60, 'price': {'consumption_portion': 200, 'consumption_total': 1700, 'portion': 350, 'total': 2700, 'updated_at': '2025-10-26T06:03:51+01:00'}, 'promotion': 'full', 'renditions': [{'aspect': 'square', 'bit_rate': 2081, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 903