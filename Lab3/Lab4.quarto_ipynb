us-east-1/video-api/assets/77102.jpg', 'tips_and_ratings_enabled': True, 'tips_summary': {'by_line': 'Powered By Botatouille', 'content': '• Reduce the cream cheese filling by half to avoid overwhelming the meatballs 🧀✂️\\n• Double the meatball portion to balance the deliciousness 🥩🥩\\n• Ensure meatballs are well rolled to prevent bursting during cooking 💥🔒\\n• Freeze the filling in an ice cube tray for easy rolling later ❄️💡\\n• Add more breadcrumbs for better texture and stability 🍞👌', 'header': 'Highlights'}, 'topics': [{'name': 'Bread Lovers', 'slug': 'bread'}, {'name': 'Weekend Meal Prep', 'slug': 'meal-prep'}, {'name': 'Romantic Dinners', 'slug': 'romantic-dinners'}, {'name': 'Dinner', 'slug': 'dinner'}, {'name': 'Pasta', 'slug': 'pasta'}, {'name': 'Italian', 'slug': 'italian'}], 'total_time_minutes': 36, 'total_time_tier': {'display_tier': 'Under 45 minutes', 'tier': 'under_45_minutes'}, 'updated_at': 1683237600, 'user_ratings': {'count_negative': 12, 'count_positive': 262, 'score': 0.9562043795620438}, 'video_ad_content': 'none', 'video_id': 308, 'video_url': 'https://vid.tasty.co/output/43921/low_1500407525.m3u8', 'yields': 'Servings'}, {'approved_at': 1522183460, 'aspect_ratio': '1:1', 'beauty_url': None, 'brand': None, 'brand_id': None, 'buzz_id': 4784348, 'canonical_id': 'recipe:978', 'compilations': [{'approved_at': 1580777511, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1388', 'country': 'US', 'created_at': 1580453851, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 1388, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '11 Deliciously Epic Meatball Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '11-deliciously-epic-meatball-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/253648.jpg', 'video_id': 99735, 'video_url': 'https://vid.tasty.co/output/159047/hls24_1580453958.m3u8'}, {'approved_at': 1602854507, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1748', 'country': 'US', 'created_at': 1602777739, 'description': 'Looking for some delicious dinner recipes? Try one of these red meat dishes! They take very little prep work and the final results are quite impressive. Recipes like <a href=\"https://tasty.co/recipe/beef-stroganoff\">Beef Stroganoff</a> and <a href=\"https://tasty.co/recipe/garlic-herb-crusted-roast-rack-of-lamb\">Garlic Herb Crusted Roast Rack of Lamb</a> are perfect for your next date night. Don’t forget an extra bottle of wine!', 'draft_status': 'published', 'facebook_posts': [], 'id': 1748, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Red Meat Dinners', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'red-meat-dinners', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/287747.jpg', 'video_id': 115900, 'video_url': 'https://vid.tasty.co/output/181923/hls24_1602778249.m3u8'}, {'approved_at': 1635784723, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2895', 'country': 'US', 'created_at': 1634890131, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 2895, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '25 Days 25 Bacon Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '25-days-25-bacon-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/349773.jpg', 'video_id': 144487, 'video_url': 'https://vid.tasty.co/output/220925/hls24_1635490580.m3u8'}, {'approved_at': 1648228583, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:3096', 'country': 'US', 'created_at': 1647313252, 'description': 'March is here and that means so is a season of magnificent basketball! It’s time to get your brackets straight and cheer your heart out for your time. From <a href=\"https://tasty.co/recipe/cheesy-chicken-nuggets\">Cheesy Chicken Nuggets</a> to <a href=\"https://tasty.co/recipe/fish-and-chips\">Fish & Chips</a>, we are making sure that you get the perfect fuel for this action-packed season. Turn the game on, sit back on your couch and get yourself one of our tasty snacks!', 'draft_status': 'published', 'facebook_posts': [], 'id': 3096, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Snacks for March Madness', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'snacks-for-march-madness', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://s3.amazonaws.com/video-api-prod/assets/6169dddf43b84b8c9a373e19aff41c76/March_Madness_OnO.jpg', 'video_id': 153725, 'video_url': None}, {'approved_at': 1652970321, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:3166', 'country': 'US', 'created_at': 1652425041, 'description': 'Meatballs are easy and fun to make from scratch and they\\'re perfect for all of your favorite recipes! You can pair them with spaghetti, sandwiches, soups, and game-day snacks! We are here to share some amazing meatball recipes with you! Try out our <a href=\"https://tasty.co/recipe/cheesy-meatball-bake\">Cheesy Meatball Bake</a> and these cheesy and crispy. <a href=\"https://tasty.co/recipe/meatball-mozzarella-sticks\">Meatball Mozzarella Sticks</a> that will make you the King or Queen of meatballs!', 'draft_status': 'published', 'facebook_posts': [], 'id': 3166, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Meatballs For Everyone!', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'meatballs-for-everyone', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/377777.jpg', 'video_id': 157501, 'video_url': 'https://vid.tasty.co/output/239268/hls24_1652425377.m3u8'}], 'cook_time_minutes': 35, 'country': 'GB', 'created_at': 1493236100, 'credits': [{'is_verified': False, 'name': None, 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"Feast on BBQ bacon meatballs that'll have you singing the praises of this mouthwatering trio. Smoky bacon and juicy beef intertwine, smothered in a tangy BBQ sauce, to create a flavor explosion that's truly unforgettable.\", 'draft_status': 'published', 'facebook_posts': [], 'id': 978, 'inspired_by_url': None, 'instructions': [{'appliance': None, 'display_text': 'Preheat the oven to 400°F (200°C) (or 350°F (180°C) on a convection oven).', 'end_time': 0, 'id': 7086, 'position': 1, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'In a large bowl, mix the ground beef, ground sausage, bread crumbs, onion, garlic, and egg together with your hands until thoroughly combined.', 'end_time': 12117, 'id': 7087, 'position': 2, 'start_time': 1000, 'temperature': None}, {'appliance': None, 'display_text': 'Roll the mixture into golf ball-sized balls. Use your thumb to create a dent in the balls, add a bit of mozzarella and seal.', 'end_time': 18517, 'id': 7088, 'position': 3, 'start_time': 13117, 'temperature': None}, {'appliance': None, 'display_text': 'Cut the bacon rashers in half and roll around the meatballs.', 'end_time': 25517, 'id': 7089, 'position': 4, 'start_time': 19517, 'temperature': None}, {'appliance': None, 'display_text': 'Place the meatballs on a foil-covered tray and bake for 20 minutes.', 'end_time': 29100, 'id': 7090, 'position': 5, 'start_time': 25917, 'temperature': None}, {'appliance': None, 'display_text': 'Remove from the oven and brush with BBQ sauce, then bake for 5 minutes more. Repeat brushing and baking two more times for an extra-thick layer of BBQ sauce.', 'end_time': 39117, 'id': 7091, 'position': 6, 'start_time': 30351, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 46867, 'id': 7092, 'position': 7, 'start_time': 43417, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': None, 'language': 'eng', 'name': 'BBQ Bacon Meatballs', 'num_servings': 2, 'nutrition': {}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/17de0fa61ffc4040af402e2a5cb97eea/BBQ_Bacon_Meatballs.mp4', 'prep_time_minutes': 20, 'price': {'consumption_portion': 650, 'consumption_total': 1250, 'portion': 1350, 'total': 2750, 'updated_at': '2025-10-26T06:05:47+01:00'}, 'promotion': 'full', 'renditions': [{'aspect': 'square', 'bit_rate': 7306, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 48388, 'file_size': 44188674, 'height': 720, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_720x720', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/31851/mp4_1280X720/1495124849_00001.png', 'url': 'https://vid.tasty.co/output/31851/mp4_1280X720/1495124849', 'width': 720}, {'aspect': 'square', 'bit_rate': None, 'container': 'mp4', 'content_type': 'application/vnd.apple.mpegurl', 'duration': 48362, 'file_size': None, 'height': 1080, 'maximum_bit_rate': 8262, 'minimum_bit_rate': 280, 'name': 'low', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/31851/1445289064805-h2exzu/1495124849_00001.png', 'url': 'https://vid.tasty.co/output/31851/low_1495124849.m3u8', 'width': 1080}, {'aspect': 'square', 'bit_rate': 7310, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 48388, 'file_size': 44212475, 'height': 640, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_640x640', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/31851/mp4_640x640/1495124849_00001.png', 'url': 'https://vid.tasty.co/output/31851/mp4_640x640/1495124849', 'width': 640}, {'aspect': 'square', 'bit_rate': 7302, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 483