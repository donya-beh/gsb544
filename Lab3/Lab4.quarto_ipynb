.co/output/33249/mp4_640x640/1496357867', 'width': 640}, {'aspect': 'square', 'bit_rate': 7396, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 81007, 'file_size': 74881046, 'height': 720, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_720x720', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/33249/mp4_720x1280/1496357867_00001.png', 'url': 'https://vid.tasty.co/output/33249/mp4_720x1280/1496357867', 'width': 720}], 'sections': [{'components': [{'extra_comment': '', 'id': 20599, 'ingredient': {'created_at': 1493920746, 'display_plural': 'ground beefs', 'display_singular': 'ground beef', 'id': 161, 'name': 'ground beef', 'updated_at': 1509035282}, 'measurements': [{'id': 390706, 'quantity': '1', 'unit': {'abbreviation': 'lb', 'display_plural': 'lb', 'display_singular': 'lb', 'name': 'pound', 'system': 'imperial'}}, {'id': 390704, 'quantity': '455', 'unit': {'abbreviation': 'g', 'display_plural': 'g', 'display_singular': 'g', 'name': 'gram', 'system': 'metric'}}], 'position': 1, 'raw_text': '1 pound ground beef'}, {'extra_comment': '', 'id': 20600, 'ingredient': {'created_at': 1493307128, 'display_plural': 'garlic powders', 'display_singular': 'garlic powder', 'id': 9, 'name': 'garlic powder', 'updated_at': 1509035289}, 'measurements': [{'id': 390700, 'quantity': '1', 'unit': {'abbreviation': 'tsp', 'display_plural': 'teaspoons', 'display_singular': 'teaspoon', 'name': 'teaspoon', 'system': 'imperial'}}], 'position': 2, 'raw_text': '1 teaspoon garlic powder'}, {'extra_comment': '', 'id': 20601, 'ingredient': {'created_at': 1493307116, 'display_plural': 'onion powders', 'display_singular': 'onion powder', 'id': 8, 'name': 'onion powder', 'updated_at': 1509035289}, 'measurements': [{'id': 390712, 'quantity': '1', 'unit': {'abbreviation': 'tsp', 'display_plural': 'teaspoons', 'display_singular': 'teaspoon', 'name': 'teaspoon', 'system': 'imperial'}}], 'position': 3, 'raw_text': '1 teaspoon onion powder'}, {'extra_commen