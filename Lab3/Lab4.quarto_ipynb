ys', 'promotion': 'full', 'show': [{'id': 34, 'name': 'Goodful'}], 'slug': 'meatless-meatballs-4-ways', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/132265.jpg', 'video_id': 39393, 'video_url': 'https://vid.tasty.co/output/74558/hls24_1516819294.m3u8'}, {'approved_at': 1565183662, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1059', 'country': 'US', 'created_at': 1565174737, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 1059, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': '5 Meatless Recipes That Taste Delicious', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': '5-meatless-recipes-that-taste-delicious', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/228488.jpg', 'video_id': 89045, 'video_url': 'https://vid.tasty.co/output/141271/hls24_1565174653.m3u8'}], 'cook_time_minutes': 30, 'country': 'US', 'created_at': 1516757577, 'credits': [{'is_verified': False, 'name': 'Crystal Hatch', 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': 'A vegetarian take on classic meatballs that uses mushrooms and walnuts as the base and is baked in a tomato sauce.', 'draft_status': 'published', 'facebook_posts': [], 'id': 3390, 'inspired_by_url': 'http://cooktoria.com/recipe/mushroom-meatballs/', 'instructions': [{'appliance': None, 'display_text': 'Heat the oil in a large skillet over medium heat. Add the mushrooms and cook until beginning to brown, stirring occasionally.', 'end_time': 12333, 'id': 28719, 'position': 1, 'start_time': 6000, 'temperature': None}, {'appliance': None, 'display_text': 'Add the onion and cook until translucent. Add the garlic and stir until fragrant. Transfer the mushroom mixture to a large bowl.', 'end_time': 26333, 'id': 28720, 'position': 2, 'start_time': 12000, 'temperature': None}, {'appliance': None, 'display_text': 'Add the bread crumbs, oats, parsley,  vegetarian Parmesan, oregano, rosemary, thyme, salt, pepper, and cayenne, if using, and stir to combine. Add the eggs and mix well.', 'end_time': 43666, 'id': 28721, 'position': 3, 'start_time': 27000, 'temperature': None}, {'appliance': None, 'display_text': 'Cover the bowl and refrigerate for at least 2 hours, or overnight.', 'end_time': 0, 'id': 28723, 'position': 4, 'start_time': 0, 'temperature': None}, {'appliance': 'oven', 'display_text': 'Preheat the oven to 375°F (190°C). Line a baking sheet with parchment paper.', 'end_time': 0, 'id': 28718, 'position': 5, 'start_time': 0, 'temperature': 375}, {'appliance': None, 'display_text': 'Use your hands to roll the mushroom mixture into 1-inch (2-cm) balls. Arrange on the preparead baking sheet, spacing evenly.', 'end_time': 63000, 'id': 28724, 'position': 6, 'start_time': 53000, 'temperature': None}, {'appliance': None, 'display_text': 'Bake the \"meat\"balls, flipping halfway, for 20 minutes, or until golden brown.', 'end_time': 70166, 'id': 28725, 'position': 7, 'start_time': 64000, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 80833, 'id': 28726, 'position': 8, 'start_time': 73000, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': 'black bean meatballs, black bean tofu meatballs, chickpea meatballs, chickpeas, eggplant, eggplant meatballs, goodful, healthy, healthy meatballs, impossible meatballs, light, meatball stroganoff, meatball sub, meatballs, meatless, meatless meatballs, mushroom meatballs, mushrooms, spaghetti and meatballs, swedish meatballs, tofu meatballs, vegetarian, vegetarian meatball recipe, vegetarian meatballs', 'language': 'eng', 'name': 'Mushroom “Meat”balls', 'num_servings': 4, 'nutrition': {'calories': 425, 'carbohydrates': 56, 'fat': 14, 'fiber': 6, 'protein': 18, 'sugar': 7, 'updated_at': '2024-09-03T03: