 '5-meatball-recipes-you-can-t-resist', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/247851.jpg', 'video_id': 97304, 'video_url': 'https://vid.tasty.co/output/154983/hls24_1576234793.m3u8'}, {'approved_at': 1599746029, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1631', 'country': 'US', 'created_at': 1596658603, 'description': None, 'draft_status': 'published', 'facebook_posts': [], 'id': 1631, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Healthy Vegan Dinner Recipes', 'promotion': 'full', 'show': [{'id': 34, 'name': 'Goodful'}], 'slug': 'healthy-vegan-dinner-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/277308.jpg', 'video_id': 110881, 'video_url': 'https://vid.tasty.co/output/177105/hls24_1598468686.m3u8'}], 'cook_time_minutes': 15, 'country': 'US', 'created_at': 1523287243, 'credits': [{'is_verified': False, 'name': \"Merle O'Neal\", 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"Indulge in this One-Pot Vegan Swedish Meatball Pasta that's a delightful twist on a classic dish. With its creamy sauce and tender meatless meatballs, you'll be savoring every bite of this easy-to-make meal.\", 'draft_status': 'published', 'facebook_posts': [], 'id': 3722, 'inspired_by_url': 'https://www.connoisseurusveg.com/vegan-sweedish-meatballs/', 'instructions': [{'appliance': None, 'display_text': 'In a large bowl, combine the mushrooms, beans, onion, bread crumbs, parsley, garlic, dried rosemary, Worcestershire sauce, soy sauce, nutmeg, liquid smoke, salt, and pepper. Mix well with a fork, mashing the beans a bit to form a paste.', 'end_time': 25333, 'id': 32392, 'position': 1, 'start_time': 1833, 'temperature': None}, {'appliance': None, 'display_text': 'Heat the canola oil in a large pot over medium-high heat.', 'end_time': 0, 'id': 32393, 'position': 2, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Roll the “meatball” mixture and into golf ball-sized balls. Place the balls in the pot and cook for 1 minute on each side until browned.', 'end_time': 36500, 'hacks': [{'end_index': 134, 'id': 13, 'match': 'browned', 'start_index': 128}], 'id': 32394, 'position': 3, 'start_time': 28333, 'temperature': None}, {'appliance': None, 'display_text': 'Add the vegetable broth, coconut milk, Worcestershire sauce, salt, pepper, and flour, and gently stir until evenly combined.', 'end_time': 50066, 'id': 32395, 'position': 4, 'start_time': 37833, 'temperature': None}, {'appliance': None, 'display_text': 'Bring the liquid to a boil, then add the pasta. Stir constantly until the pasta is cooked and the liquid has reduced to a sauce that coats the noodles and meatballs, 7-8 minutes.', 'end_time': 56800, 'hacks': [{'end_index': 25, 'id': 18, 'match': 'boil', 'start_index': 22}], 'id': 32396, 'position': 5, 'start_time': 52566, 'temperature': None}, {'appliance': None, 'display_text': 'Garnish with parsley.', 'end_time': 61166, 'id': 32397, 'position': 6, 'start_time': 58000, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 63833, 'id': 32398, 'position': 7, 'start_time': 62000, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': 'tasty, tasty_vegetarian', 'language': 'eng', 'name': 'One-Pot Vegan Swedish \"Meatball\" Pasta', 'num_servings': 8, 'nutrition': {'calories': 318, 'carbohydrates': 44, 'fat': 10, 'fiber': 6, 'protein': 10, 'sugar': 5, 'updated_at': '2024-09-03T03:10:44+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/9a245c0c6d4c4f9a8ea4896732c96cfc/fb.mp4', 'prep_time_minutes': 20, 'price': {'consumption_portion': 100, 'consumption_total': 800, 'portion': 500, 'total': 3850, 'updated_at': '2025-10-26T06:05:31+01: