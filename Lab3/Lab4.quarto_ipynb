 'position': 7, 'raw_text': '2 28-ounce cans of whole peeled tomatoes'}, {'extra_comment': 'to taste', 'id': 52672, 'ingredient': {'created_at': 1493307153, 'display_plural': 'kosher salts', 'display_singular': 'kosher salt', 'id': 11, 'name': 'kosher salt', 'updated_at': 1509035289}, 'measurements': [{'id': 789955, 'quantity': '0', 'unit': {'abbreviation': '', 'display_plural': '', 'display_singular': '', 'name': '', 'system': 'none'}}], 'position': 8, 'raw_text': 'Kosher salt, to taste'}], 'name': 'Sauce', 'position': 1}, {'components': [{'extra_comment': 'hearty, crusts removed, torn in 1/2 ( 1 1/4 cm) in pieces', 'hacks': [{'end_index': 6, 'id': 6, 'match': 'slice', 'start_index': 2}], 'id': 52674, 'ingredient': {'created_at': 1495674295, 'display_plural': 'white breads', 'display_singular': 'white bread', 'id': 717, 'name': 'white bread', 'updated_at': 1509035238}, 'measurements': [{'id': 789945, 'quantity': '2', 'unit': {'abbreviation': 'slice', 'display_plural': 'slices', 'display_singular': 'slice', 'name': 'slice', 'system': 'none'}}], 'position': 10, 'raw_text': '2 slices of hearty white bread, crusts removed, torn into ½-inch pieces'}, {'extra_comment': '', 'id': 52675, 'ingredient': {'created_at': 1494214054, 'display_plural': 'heavy creams', 'display_singular': 'heavy cream', 'id': 221, 'name': 'heavy cream', 'updated_at': 1509035278}, 'measurements': [{'id': 789946, 'quantity': '10', 'unit': {'abbreviation': 'tbsp', 'display_plural': 'tablespoons', 'display_singular': 'tablespoon', 'name': 'tablespoon', 'system': 'imperial'}}], 'position': 11, 'raw_text': '10 tablespoons heavy cream'}, {'extra_comment': '', 'id': 52676, 'ingredient': {'created_at': 1497741203, 'display_plural': 'grated parmesan cheeses', 'display_singular': 'grated parmesan cheese', 'id': 1869, 'name': 'grated parmesan cheese', 'updated_at': 1509035159}, 'measurements': [{'id': 789944, 'quantity': '½', 'unit': {'abbreviation': 'c', 'display_plural': 'cups', 'display_singular': 'cup', '