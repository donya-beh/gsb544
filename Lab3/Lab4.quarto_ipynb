assets/276651.jpg', 'video_id': 109532, 'video_url': 'https://vid.tasty.co/output/174864/hls24_1596188024.m3u8'}, {'approved_at': 1600108969, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:1684', 'country': 'US', 'created_at': 1598896707, 'description': 'Having trouble deciding what you should make next? Take a look at a few of the best pasta recipes we have to offer! From a <a href=\"https://tasty.co/recipe/vegan-mac-n-cheese\">vegan version of mac \\'n\\' cheese</a> to delicious <a href=\"https://tasty.co/recipe/spaghetti-meatball-bake\">baked meatballs and spaghetti</a>, these ideas will satisfy every craving. Pair your pasta with a salad, dessert, and glass of wine — and you\\'ve got a restaurant-quality menu right at home!', 'draft_status': 'published', 'facebook_posts': [], 'id': 1684, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': \"Tasty's Best Pasta Recipes\", 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'tasty-s-best-pasta-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/281005.jpg', 'video_id': 112179, 'video_url': 'https://vid.tasty.co/output/177582/hls24_1598903165.m3u8'}, {'approved_at': 1609344209, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2021', 'country': 'US', 'created_at': 1609143477, 'description': '2020 has cooked up a storm in our lives and in our kitchens! We\\'ve hand-picked the best of the best trends of the year and are serving you some hot delicious dinners. From the insta-worthy <a href=\"https://tasty.co/recipe/rainbow-grilled-chicken-salad\">Rainbow Grilled Chicken Salad</a> to the <a href=\"https://tasty.co/recipe/zaatar-chicken-and-rice-pilaf\">Za\\'atar Chicken and Rice Pilaf</a>, this year has been great for all you foodies! Remember, let\\'s leave the year behind but not the recipes.', 'draft_status': 'published', 'facebook_posts': [], 'id': 2021, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': \"Tasty's Best Dinners Of 2020\", 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'tasty-s-best-dinners-of-2020', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/301791.jpg', 'video_id': 121991, 'video_url': 'https://vid.tasty.co/output/189791/hls24_1609239151.m3u8'}, {'approved_at': 1617195181, 'aspect_ratio': '1:1', 'beauty_url': None, 'buzz_id': None, 'canonical_id': 'compilation:2219', 'country': 'US', 'created_at': 1615809320, 'description': 'We\\'ve curated a special assortment of pasta recipes just for you. From our unique <a href=\"https://tasty.co/recipe/tomato-and-anchovy-pasta\">tomato anchovy pasta</a> to mouth-watering <a href=\"https://tasty.co/recipe/one-pot-chicken-bacon-and-goat-cheese\">chicken, bacon and goat cheese pasta</a>, these recipes are made to impress! We\\'re going to go eat our hearts out now: time to get cooking!', 'draft_status': 'published', 'facebook_posts': [], 'id': 2219, 'is_shoppable': False, 'keywords': None, 'language': 'eng', 'name': 'Make The Perfect Bowl Of Pasta With These Recipes', 'promotion': 'full', 'show': [{'id': 17, 'name': 'Tasty'}], 'slug': 'make-the-perfect-bowl-of-pasta-with-these-recipes', 'thumbnail_alt_text': '', 'thumbnail_url': 'https://img.buzzfeed.com/thumbnailer-prod-us-east-1/video-api/assets/314886.jpg', 'video_id': 127253, 'video_url': 'https://vid.tasty.co/output/198051/hls24_1617121116.m3u8'}], 'cook_time_minutes': 20, 'country': 'US', 'created_at': 1521827108, 'credits': [{'is_verified': False, 'name': 'Rie McClenny', 'picture_url': '', 'type': 'internal', 'user_id': None}], 'description': \"These jumbo pasta shells are stuffed with flavorful meatballs and topped with melted mozzarella cheese. Baked in a rich tomato sauce and loaded with herbs, it's a comforting and delicious dinner that the whole family will love.\", 'draft_status': 'published', 'facebook_posts': [], 'id': 3638, 'inspired_by_url': 'http://www.plainchicken.com/2014/11/meatball-stuffed-shells.html#more', 'instructions': [{'appliance': None, 'display_text': 'In a medium bowl, mix together the beef, pork, bread crumbs, onion, Parmesan cheese, garlic, parsley, eggs, salt, and pepper until just combined.', 'end_time': 22166, 'id': 31507, 'position': 1, 'start_time': 5666, 'temperature': None}, {'appliance': 'oven', 'display_text': 'Preheat the oven to 425°F (220°C).', 'end_time': 0, 'id': 31506, 'position': 2, 'start_time': 0, 'temperature': 425}, {'appliance': None, 'display_text': 'Take a walnut-sized portion of the meat mixture and roll into a ball. Repeat with remaining meat and transfer to an oiled wire rack set over a baking sheet.', 'end_time': 25833, 'id': 31508, 'position': 3, 'start_time': 21666, 'temperature': None}, {'appliance': None, 'display_text': 'Bake the meatballs for 10 minutes, until golden brown.', 'end_time': 28500, 'id': 31509, 'position': 4, 'start_time': 25833, 'temperature': None}, {'appliance': None, 'display_text': 'Make the ricotta-herb mixture: combine the ricotta cheese, basil, parsley, Parmesan cheese, and salt in a medium bowl and mix well.', 'end_time': 38866, 'id': 31510, 'position': 5, 'start_time': 29000, 'temperature': None}, {'appliance': None, 'display_text': 'Stuff a tablespoon of ricotta mixture into a jumbo shells, then stuff a meatball into the shells.', 'end_time': 49400, 'id': 31511, 'position': 6, 'start_time': 39699, 'temperature': None}, {'appliance': None, 'display_text': 'Spread the marinara sauce in the bottom of a 9x13-inch (23x33-cm) casserole dish, then lay in the stuffed shells. Sprinkle Parmesan cheese on top.', 'end_time': 62000, 'id': 31512, 'position': 7, 'start_time': 49733, 'temperature': None}, {'appliance': None, 'display_text': 'Bake for 10 minutes, until the marinara sauce is warm.', 'end_time': 0, 'id': 31513, 'position': 8, 'start_time': 0, 'temperature': None}, {'appliance': None, 'display_text': 'Top with chopped basil.', 'end_time': 71533, 'hacks': [{'end_index': 15, 'id': 1, 'match': 'chopped', 'start_index': 9}], 'id': 31514, 'position': 9, 'start_time': 65000, 'temperature': None}, {'appliance': None, 'display_text': 'Enjoy!', 'end_time': 82900, 'id': 31515, 'position': 10, 'start_time': 72200, 'temperature': None}], 'is_app_only': False, 'is_one_top': False, 'is_shoppable': True, 'is_subscriber_content': False, 'keywords': None, 'language': 'eng', 'name': 'Meatball Stuffed Shell Pasta', 'num_servings': 4, 'nutrition': {'calories': 1500, 'carbohydrates': 113, 'fat': 72, 'fiber': 7, 'protein': 99, 'sugar': 17, 'updated_at': '2024-09-03T03:10:44+02:00'}, 'nutrition_visibility': 'auto', 'original_video_url': 'https://s3.amazonaws.com/video-api-prod/assets/e49da96d168f49d0b58b21dd26a54a6e/FINAL.mp4', 'prep_time_minutes': 30, 'price': {'consumption_portion': 650, 'consumption_total': 2600, 'portion': 1000, 'total': 4050, 'updated_at': '2025-10-26T06:05:51+01:00'}, 'promotion': 'full', 'renditions': [{'aspect': 'square', 'bit_rate': 2027, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 97060, 'file_size': 24589341, 'height': 720, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_720x720', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/86491/square_720/1521844989_00001.png', 'url': 'https://vid.tasty.co/output/86491/square_720/1521844989', 'width': 720}, {'aspect': 'square', 'bit_rate': 678, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 97060, 'file_size': 8220624, 'height': 320, 'maximum_bit_rate': None, 'minimum_bit_rate': None, 'name': 'mp4_320x320', 'poster_url': 'https://img.buzzfeed.com/video-transcoder-prod/output/86491/square_320/1521844989_00001.png', 'url': 'https://vid.tasty.co/output/86491/square_320/1521844989', 'width': 320}, {'aspect': 'square', 'bit_rate': 2025, 'container': 'mp4', 'content_type': 'video/mp4', 'duration': 97060, 'file_size': 